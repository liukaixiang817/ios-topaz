+{
+    uint64_t next=vsync;
+    if(present && (dirty || present>now) && present<next)next=present;
+    if(next>now && next-now<1000)return (uint32_t)(next-now);
+    return polaris_fb_deadline_delay_us(now,vsync,present,dirty);
+}
