+/* Completion runs inside biodone: no allocation, filesystem I/O, abort or
+ * transaction destruction is allowed here. Latch the first actual errno in
+ * separate RAM so a concurrent legacy flags update cannot lose the failure. */
+static int
+polaris_journal_io_error(const journal *jnl, int fallback)
+{
+    int error = __atomic_load_n(&jnl->async_write_error, __ATOMIC_ACQUIRE);
+    return error ? error : fallback;
+}
