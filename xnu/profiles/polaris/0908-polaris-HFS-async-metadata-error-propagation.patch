+static bool
+polaris_journal_invalid(const journal *jnl)
+{
+    return __atomic_load_n(&jnl->async_write_error, __ATOMIC_ACQUIRE) != 0 ||
+        (jnl->flags & JOURNAL_INVALID) != 0;
+}
