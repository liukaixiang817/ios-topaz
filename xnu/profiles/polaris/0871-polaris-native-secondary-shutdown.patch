+#if defined(POLARIS_RAM_ONLY)
+/* Keep machine-private cpu_data layout in its native component. Called only
+ * from the scheduler's already-offline idle context, with IRQs masked. The
+ * token releases native cpu_exit_wait; it does NOT prove physical power OFF. */
+void polaris_uefi_bind_boot(processor_t processor)
+{
+    assert(processor == master_processor);
+    (void)thread_bind(processor);
+    thread_block(THREAD_CONTINUE_NULL);
+    assert(current_processor() == master_processor);
+}
+void polaris_uefi_publish_sleep_token(void)
+{
+    extern int polaris_uefi_cpu_exit_allowed(int);
+    assert(cpu_number() == 1 && polaris_uefi_cpu_exit_allowed(1));
+    assert(!ml_get_interrupts_enabled());
+    cpu_data_t *data = getCpuDatap();
+    data->cpu_sleep_token = ARM_CPU_ON_SLEEP_PATH;
+    CleanPoC_DcacheRegion_Force((vm_offset_t)data, sizeof(*data));
+    __builtin_arm_dsb(DSB_SY);
+}
+#endif
