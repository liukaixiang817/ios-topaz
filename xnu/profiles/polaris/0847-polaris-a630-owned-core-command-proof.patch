+    for(unsigned n=0;n<3;n++)if(!a630_core_emit(ring,s,fence[n]))goto done;
+    if(!a630_core_emit(ring,s,a630_core_pkt7(0x26,0))||!a630_core_submit(io,s)||!a630_core_sync(io,s))goto done;
