+void PolarisGPUUserClient::poison()
+{
+    gpuQuarantined=true;polaris_gpu_quarantine();
+    __atomic_store_n(&gpuFaultStatus,1,__ATOMIC_RELEASE);
+    if (!quarantined) {quarantined=true;retain();} /* DMA ownership survives task death */
