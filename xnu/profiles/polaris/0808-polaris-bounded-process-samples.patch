+#if defined(POLARIS_RAM_ONLY)
+/* Best-effort saved state, not a stackshot: never stop a target or fault its
+ * user pages. Task/thread references keep the allocation/PCB alive. Copy only
+ * bounded kernel-resident fields; release every lock before formatting text. */
+void polaris_sample_task(const char *name, int pid, task_t task);
+void
+polaris_sample_task(const char *name, int pid, task_t task)
+{
+    thread_t refs[8], thread;
+    unsigned count = 0, total;
+    uint64_t mh;
+    uint32_t slide;
+    if (!task_lock_try(task)) {
+        printf("PS %s[%d]: task busy, skipped\n", name, pid);
+        return;
+    }
+    mh = task->mach_header_vm_address;
+    slide = task->task_shared_region_slide; /* cached, UINT32_MAX = unavailable */
+    total = task->thread_count;
+    queue_iterate(&task->threads, thread, thread_t, task_threads) {
+        if (count == sizeof(refs) / sizeof(refs[0])) { break; }
+        thread_reference(thread);
+        refs[count++] = thread;
+    }
+    task_unlock(task);
+    printf("PS %s[%d] slide=0x%x mh=0x%llx threads=%u sampled=%u\n",
+        name, pid, slide, mh, total, count);
+    for (unsigned i = 0; i < count; i++) {
+        uint64_t pc = 0, lr = 0, sp = 0, fp = 0, x16 = 0;
+        uint64_t tid, event, continuation;
+        unsigned state;
+        bool valid = false;
+        thread = refs[i];
+        spl_t s = splsched();
+        thread_lock(thread);
+        arm_saved_state_t *ss = find_user_regs(thread);
+        if (ss && is_saved_state64(ss)) {
+            pc = get_saved_state_pc(ss);
+            lr = get_saved_state_lr(ss);
+            sp = get_saved_state_sp(ss);
+            fp = get_saved_state_fp(ss);
+            x16 = get_saved_state_reg(ss, 16);
+            valid = true;
+        }
+        tid = thread->thread_id;
+        event = thread->wait_event;
+        continuation = (uintptr_t)thread->continuation;
+        state = (unsigned)thread->state;
+        thread_unlock(thread);
+        splx(s);
+        thread_deallocate(thread);
+        printf("PS %s t%u id=%llu state=0x%x event=0x%llx cont=0x%llx\n",
+            name, i, tid, state, event, continuation);
+        printf("PS %s t%u valid=%u pc=0x%llx lr=0x%llx sp=0x%llx fp=0x%llx x16=0x%llx\n",
+            name, i, valid, pc, lr, sp, fp, x16);
+    }
+}
+#endif
