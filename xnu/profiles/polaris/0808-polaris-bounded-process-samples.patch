+#if defined(POLARIS_RAM_ONLY)
+/* Explicit opt-in, register-only samples. Never enable the legacy stack
+ * walker on polaris: it can fault user pages while holding the task lock. */
+extern void polaris_sample_task(const char *, int, task_t);
+extern kern_return_t thread_terminate(thread_t);
+
+static const char * const polaris_sample_names[] = {
+    "launchd", "SpringBoard", "backboardd", "datamigrator",
+    "com.apple.datamigrator", "migrationpluginwrapper", "usermanagerd"
+};
+struct polaris_sample_pass { unsigned seen, mask; };
+
+static int
+polaris_sample_proc(proc_t p, void *arg)
+{
+    struct polaris_sample_pass *pass = arg;
+    char name[64];
+    /* proc_iterate owns a proc reference; p_name retains long executable
+     * names, unlike proc_name(), which only returns the 16-byte p_comm. */
+    strlcpy(name, proc_best_name(p), sizeof(name));
+    for (unsigned i = 0; i < sizeof(polaris_sample_names) / sizeof(polaris_sample_names[0]); i++) {
+        if (strcmp(name, polaris_sample_names[i]) != 0) { continue; }
+        task_t task = proc_task(p);
+        if (task != TASK_NULL) {
+            task_reference(task);
+            polaris_sample_task(name, proc_pid(p), task);
+            task_deallocate(task);
+            pass->mask |= 1u << i;
+            pass->seen++;
+        }
+        break;
+    }
+    return pass->seen >= 7 ? PROC_RETURNED_DONE : PROC_RETURNED;
+}
+
+static void
+polaris_sample_thread(__unused void *arg, __unused wait_result_t wr)
+{
+    static int chan;
+    (void)tsleep(&chan, PZERO, "polsmp", 60 * hz);
+    for (unsigned i = 0; i < 24; i++) {
+        struct polaris_sample_pass pass = {0};
+        printf("\nPOLARIS SAMPLE %u: saved registers only, no user-memory reads\n", i);
+        /* Never wait for an exec/fork transition just to collect evidence. */
+        proc_iterate(PROC_ALLPROCLIST | PROC_NOWAITTRANS, polaris_sample_proc, &pass, NULL, NULL);
+        printf("PS END %u: found=%u mask=0x%x\n", i, pass.seen, pass.mask);
+        (void)tsleep(&chan, PZERO, "polsmp", 30 * hz);
+    }
+    printf("POLARIS SAMPLE: finished after 24 passes\n");
+    thread_terminate(current_thread());
+}
+#endif
 
