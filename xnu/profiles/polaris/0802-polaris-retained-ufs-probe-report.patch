--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -412,6 +412,21 @@
  * No BSD disk registration, filesystem mount, persistent logging or input/USB
  * driver startup. The normal sweet_ufs_init remains disabled on this platform.
  */
+static bool polaris_probe_report_enabled;
+static char polaris_probe_status[128];
+static const char *polaris_probe_queue_status = "not taken";
+bool polaris_ufs_probe_report(void);
+bool
+polaris_ufs_probe_report(void)
+{
+	/* Same startup thread owns both the probe and its retained report. This
+	 * function never touches UFS registers or submits another command. */
+	if (!polaris_probe_report_enabled) { return false; }
+	printf("\nPOLARIS UFS RESULT: %s\n", polaris_probe_status);
+	printf("POLARIS UFS QUEUE: %s (no new I/O)\n", polaris_probe_queue_status);
+	return true;
+}
+
 void polaris_ufs_probe(void);
 void
 polaris_ufs_probe(void)
@@ -420,6 +435,8 @@
 	if (!PE_parse_boot_argn("polarisufsprobe", &enabled, sizeof(enabled)) || enabled != 1) {
 		return;
 	}
+	polaris_probe_report_enabled = true;
+	strlcpy(polaris_probe_status, "REFUSED: initialization incomplete", sizeof(polaris_probe_status));
 	DTEntry node;
 	uintptr_t const *reg = NULL;
 	uint32_t const *expected = NULL;
@@ -429,6 +446,7 @@
 	    size != 2 * sizeof(uintptr_t) || reg[0] != 0x1d84000 || reg[1] != 0x2500 ||
 	    SecureDTGetProperty(node, "head-crc32", (void const **)&expected, &size) != kSuccess ||
 	    size != sizeof(uint32_t)) {
+		strlcpy(polaris_probe_status, "REFUSED: hardware/backup metadata", sizeof(polaris_probe_status));
 		printf("POLARIS UFS: probe refused, missing validated hardware/backup metadata\n");
 		return;
 	}
@@ -440,11 +458,13 @@
 	if (ufs_rd(0x08) != 0x210 || !(ufs_rd(REG_HCE) & 1) ||
 	    (ufs_rd(REG_HCS) & (HCS_DP | HCS_UTRLRDY)) != (HCS_DP | HCS_UTRLRDY) ||
 	    ufs_rd(REG_UTRLDBR) || ufs_rd(0x78) || ufs_rd(0x80)) {
+		strlcpy(polaris_probe_status, "REFUSED: host/link/queue state", sizeof(polaris_probe_status));
 		printf("POLARIS UFS: probe refused, host/link/queues not in expected state\n");
 		goto out;
 	}
 	if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
 	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		strlcpy(polaris_probe_status, "REFUSED: DMA allocation", sizeof(polaris_probe_status));
 		printf("POLARIS UFS: contiguous DMA allocation failed\n");
 		goto out;
 	}
@@ -472,8 +492,11 @@
 		    memcmp(b + UFS_BLOCK, "EFI PART", 8) == 0 && crc == *expected;
 		printf("POLARIS UFS: HEAD CRC32 %08x expected %08x %s\n",
 		    crc, *expected, valid ? "MATCH" : "MISMATCH");
+		snprintf(polaris_probe_status, sizeof(polaris_probe_status),
