+    uint32_t mode = 0, boot = 0, count = 0;
+    PE_parse_boot_argn("polarisuefi", &mode, sizeof(mode));
+    if (mode == 1) {
+        PE_parse_boot_argn("polarisbootcpu", &boot, sizeof(boot));
+        PE_parse_boot_argn("cpus", &count, sizeof(count));
+        conduit = polaris_uefi_psci_conduit(mode, boot, count,
+            __builtin_arm_rsr64("MPIDR_EL1"));
+        if (conduit < 0) panic("POLARIS UEFI: unbound PSCI conduit");
+    }
+#endif
 	register uint64_t x0 __asm__("x0") = 0xC4000003ULL;
 	register uint64_t x1 __asm__("x1") = target;
 	register uint64_t x2 __asm__("x2") = entry;
 	register uint64_t x3 __asm__("x3") = context;
+    if (conduit == 1) {
