+/* Narrow diagnostic policy; no generic block-device access. */
+#ifndef POLARIS_UFS_PROBE_POLICY_H
+#define POLARIS_UFS_PROBE_POLICY_H
+
+static inline bool
+polaris_probe_cdb_allowed(const uint8_t *cdb, unsigned n, uint32_t len,
+    bool write, uint8_t lun)
+{
+	if (!cdb || write || lun != 0) {
+		return false;
+	}
+	/* TEST UNIT READY, with no optional fields. */
+	if (n == 6 && len == 0) {
+		for (unsigned i = 0; i < n; i++) {
+			if (cdb[i]) { return false; }
+		}
+		return true;
+	}
+	/* Exactly READ(10), LBA 0, 256 x 4096-byte blocks, no flags. */
+	static const uint8_t read_head[10] = {0x28, 0, 0, 0, 0, 0, 0, 1, 0, 0};
+	if (n != sizeof(read_head) || len != (1u << 20)) {
+		return false;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		if (cdb[i] != read_head[i]) { return false; }
+	}
+	return true;
+}
+
+static inline uint32_t
+polaris_probe_crc32(const uint8_t *p, unsigned n)
+{
+	uint32_t crc = ~0u;
+	while (n--) {
+		crc ^= *p++;
+		for (unsigned bit = 0; bit < 8; bit++) {
+			crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1)));
+		}
+	}
+	return ~crc;
+}
+#endif
