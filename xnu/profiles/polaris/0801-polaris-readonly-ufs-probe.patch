+/* Called once by the CPU startup thread, after timer/scheduler initialization.
+ * No BSD disk registration, filesystem mount, persistent logging or input/USB
+ * driver startup. The normal sweet_ufs_init remains disabled on this platform.
+ */
+void polaris_ufs_probe(void);
+void
+polaris_ufs_probe(void)
+{
+	uint32_t enabled = 0;
+	if (!PE_parse_boot_argn("polarisufsprobe", &enabled, sizeof(enabled)) || enabled != 1) {
+		return;
+	}
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	uint32_t const *expected = NULL;
+	unsigned int size = 0;
+	if (SecureDTLookupEntry(NULL, "/polaris-ufs-probe", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size != 2 * sizeof(uintptr_t) || reg[0] != 0x1d84000 || reg[1] != 0x2500 ||
+	    SecureDTGetProperty(node, "head-crc32", (void const **)&expected, &size) != kSuccess ||
+	    size != sizeof(uint32_t)) {
+		printf("POLARIS UFS: probe refused, missing validated hardware/backup metadata\n");
+		return;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	if (su.regs || su.dma) { goto out; }
+	su.regs = ml_io_map(reg[0], reg[1]);
+	if (!su.regs) { goto out; }
+	/* Only the observed enabled, idle UFSHCI 2.1 handoff is supported. */
+	if (ufs_rd(0x08) != 0x210 || !(ufs_rd(REG_HCE) & 1) ||
+	    (ufs_rd(REG_HCS) & (HCS_DP | HCS_UTRLRDY)) != (HCS_DP | HCS_UTRLRDY) ||
+	    ufs_rd(REG_UTRLDBR) || ufs_rd(0x78) || ufs_rd(0x80)) {
+		printf("POLARIS UFS: probe refused, host/link/queues not in expected state\n");
+		goto out;
+	}
+	if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("POLARIS UFS: contiguous DMA allocation failed\n");
+		goto out;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)su.dma);
+	if (!pn) { goto out; }
+	su.dma_pa = ptoa_64(pn);
+	su.lun = 0;
+	su.cache = su.wait = su.ready = su.writable = false;
+	uint32_t old_lo = ufs_rd(REG_UTRLBA), old_hi = ufs_rd(REG_UTRLBAU);
+	uint32_t old_rsr = ufs_rd(REG_UTRLRSR), old_ie = ufs_rd(REG_IE);
+	printf("POLARIS UFS: read-only probe, LUN0 LBA0+256, DMA 0x%llx\n", su.dma_pa);
+	int error = ufs_take_over_host();
+	if (!error) {
+		static const uint8_t tur[6] = {0};
+		for (unsigned i = 0; i < 3; i++) {
+			error = ufs_scsi(tur, sizeof(tur), 0, false);
+			if (!error || error == ETIMEDOUT) { break; }
+		}
+	}
+	if (!error) { error = ufs_read_blocks(0, 256); }
+	if (!error) {
+		const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+		uint32_t crc = polaris_probe_crc32(b, BOUNCE_SIZE);
+		bool valid = b[510] == 0x55 && b[511] == 0xaa &&
+		    memcmp(b + UFS_BLOCK, "EFI PART", 8) == 0 && crc == *expected;
+		printf("POLARIS UFS: HEAD CRC32 %08x expected %08x %s\n",
+		    crc, *expected, valid ? "MATCH" : "MISMATCH");
+	} else {
+		printf("POLARIS UFS: read-only probe error %d\n", error);
+	}
+	/* On timeout leave the queue and its permanent DMA allocation alone.
+	 * No controller reset/abort: an outstanding DMA must never use freed RAM.
+	 */
+	if (error != ETIMEDOUT && !ufs_rd(REG_UTRLDBR) && !ufs_rd(0x78)) {
+		ufs_wr(REG_UTRLRSR, 0);
+		ufs_wr(REG_UTRLBA, old_lo);
+		ufs_wr(REG_UTRLBAU, old_hi);
+		ufs_wr(REG_UTRLRSR, old_rsr);
+		__builtin_arm_dsb(0xf);
+		if (ufs_rd(REG_UTRLBA) == old_lo && ufs_rd(REG_UTRLBAU) == old_hi &&
+		    ufs_rd(REG_UTRLRSR) == old_rsr) {
+			ufs_wr(REG_IE, old_ie);
+			printf("POLARIS UFS: idle queue restored; probe complete\n");
+		} else {
+			printf("POLARIS UFS: queue restoration failed; DMA retained\n");
+		}
+	} else {
+		printf("POLARIS UFS: pending/timeout; queue and DMA retained\n");
+	}
+out:
+	lck_mtx_unlock(&sweet_ufs_lock);
+}
+#endif
 
