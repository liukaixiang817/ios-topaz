+    for(unsigned n=0;n<SWEET_FB_LAYERS;n++)if(frame[n]) {
+        bool duplicate=false;
+        for(unsigned k=0;k<n;k++)if(frame[k]==frame[n]) {
+            duplicate=true;released[n]=released[k];break;
+        }
+        if(!duplicate)released[n]=pfs_release(&frame[n]->polarisGPUBusy,PFS_PANEL);
+        ok&=released[n];
