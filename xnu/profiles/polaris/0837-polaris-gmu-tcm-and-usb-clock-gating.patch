+ * conversion; adreno_a6xx.c loads 0x2000 words from ITCM_START (0x1b400).
+ * The contiguous 32KiB AHB window spans the named DTCM_START at 0x7000;
+ * do not describe the entire window as instruction-only ITCM.
+ *
+ * The caller must own the upstream
+ * power/clock/mapping lifetime, establish CM3 reset separately, and pass
+ * only the immutable firmware already checked against its recorded hash.
+ * On failure, the caller must retain CM3 reset; this helper does no cleanup
+ * that could execute a partially written image.
+ * This helper never releases reset, starts firmware, or configures DMA/HFI.
+ */
+#ifndef POLARIS_A630_TCM_H
+#define POLARIS_A630_TCM_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#ifndef POLARIS_A630_IMAGES_H
+#error Include Polaris firmware image definitions first
+#endif
+
+#define A630_GMU_GPU_WORD_BASE 0x1a800u
+#define A630_GMU_REGISTER_BYTES 0x30000u
+#define A630_GMU_CM3_RESET 0x14000u
+#define A630_GMU_FLAT_START 0x3000u
+#define A630_GMU_FLAT_BYTES 0x8000u
+
+enum a630_tcm_result {
+    A630_TCM_DISABLED, A630_TCM_ARGUMENT, A630_TCM_LEASE_LOST,
+    A630_TCM_IO, A630_TCM_NOT_RESET, A630_TCM_MISMATCH,
+    A630_TCM_VERIFIED
+};
+enum a630_tcm_phase { A630_TCM_ADMISSION, A630_TCM_COPY, A630_TCM_READBACK };
+struct a630_tcm_snapshot {
+    uint32_t result, phase, offset, expected, actual, reads, writes, barriers;
+};
+struct a630_tcm_io {
+    bool (*admitted)(void *); /* exclusive, live power/clock/mapping lease */
+    bool (*read)(void *, uint32_t byte_offset, uint32_t *);
+    bool (*write)(void *, uint32_t byte_offset, uint32_t);
+    bool (*sync)(void *); /* posted writes must finish before readback */
+};
+
+static inline bool a630_gmu_word_offset(uint32_t gpu_word, uint32_t *local_byte)
+{
+    if (!local_byte || gpu_word < A630_GMU_GPU_WORD_BASE ||
+        gpu_word - A630_GMU_GPU_WORD_BASE >= A630_GMU_REGISTER_BYTES / 4)
+        return false;
+    *local_byte = (gpu_word - A630_GMU_GPU_WORD_BASE) * 4;
+    return true;
+}
+
+static inline bool a630_tcm_guard(const struct a630_tcm_io *io, void *ctx,
+                                struct a630_tcm_snapshot *s)
+{
+    if (!io->admitted(ctx)) { s->result = A630_TCM_LEASE_LOST; return false; }
+    uint32_t reset;
+    s->offset = A630_GMU_CM3_RESET;
+    s->expected = 1;
+    s->actual = 0;
+    s->reads++;
+    if (!io->read(ctx, A630_GMU_CM3_RESET, &reset)) {
+        s->result = A630_TCM_IO; return false;
+    }
+    s->actual = reset;
+    if (reset != 1) { s->result = A630_TCM_NOT_RESET; return false; }
+    return true;
+}
+
+static inline enum a630_tcm_result
+a630_tcm_load(bool exact_board, bool original_hash_verified,
+              const struct a630_image *image, const struct a630_tcm_io *io,
+              void *ctx, struct a630_tcm_snapshot *s)
+{
+    if (!s) return A630_TCM_ARGUMENT;
+    *s = (struct a630_tcm_snapshot){0};
+    if (!exact_board || !original_hash_verified) return A630_TCM_DISABLED;
+    if (!image || !image->data || image->bytes != A630_GMU_FLAT_BYTES ||
+        !io || !io->admitted || !io->read || !io->write || !io->sync) {
+        s->result = A630_TCM_ARGUMENT; return A630_TCM_ARGUMENT;
+    }
+    /* Validate the original little-endian CM3 vector before any MMIO. */
+    uint32_t sp = a630_image_word(image->data);
+    uint32_t reset = a630_image_word(image->data + 4);
+    if (sp < 0x40000 || sp > 0x44000 || (sp & 7) ||
+        !(reset & 1) || reset >= image->bytes) {
+        s->result = A630_TCM_ARGUMENT; return A630_TCM_ARGUMENT;
+    }
+    if (!a630_tcm_guard(io, ctx, s)) return (enum a630_tcm_result)s->result;
+    s->phase = A630_TCM_COPY;
+    for (uint32_t at = 0; at < image->bytes; at += 4) {
+        if (!a630_tcm_guard(io, ctx, s)) return (enum a630_tcm_result)s->result;
+        s->offset = A630_GMU_FLAT_START + at;
+        s->expected = a630_image_word(image->data + at);
+        s->actual = 0;
+        s->writes++;
+        if (!io->write(ctx, s->offset, s->expected)) {
+            s->result = A630_TCM_IO; return A630_TCM_IO;
+        }
+    }
+    /* No reset/firmware-start write occurs on either success or failure. */
+    if (!a630_tcm_guard(io, ctx, s)) return (enum a630_tcm_result)s->result;
+    s->barriers++;
+    if (!io->sync(ctx)) { s->result = A630_TCM_IO; return A630_TCM_IO; }
+    s->phase = A630_TCM_READBACK;
+    for (uint32_t at = 0; at < image->bytes; at += 4) {
+        if (!a630_tcm_guard(io, ctx, s)) return (enum a630_tcm_result)s->result;
+        s->offset = A630_GMU_FLAT_START + at;
+        s->expected = a630_image_word(image->data + at);
+        s->actual = 0;
+        s->reads++;
+        if (!io->read(ctx, s->offset, &s->actual)) {
+            s->result = A630_TCM_IO; return A630_TCM_IO;
+        }
+        if (s->actual != s->expected) {
+            s->result = A630_TCM_MISMATCH; return A630_TCM_MISMATCH;
+        }
+    }
+    if (!a630_tcm_guard(io, ctx, s)) return (enum a630_tcm_result)s->result;
+    s->result = A630_TCM_VERIFIED; return A630_TCM_VERIFIED;
+}
+#endif
--- /dev/null
+++ b/bsd/dev/polaris_a630_gmu.h
@@ -0,0 +1,74 @@
+/* Original A630 flat firmware loading. MiCode c7cb50c1 adreno_a6xx.c
+ * a6xx_gmu_start defines CM3_SYSRESET=1 as processor reset; fw_load writes
+ * 8192 words through ITCM_START. Reference redwood_adreno.c steps6/10/14
+ * independently exercise CSR/TCM before execution. Use Polaris addresses
+ * and format, not the A642L/A660 firmware or register namespace.
+ *
+ * Invoked only inside the verified, exclusive CX/clock lease, under GMU_BCR.
+ * Never release block/CM3 reset, configure DMA, or execute this image. If a
+ * reset write was attempted, caller MUST retain block reset even on failure.
+ * A reset-held bus may refuse writes; report the first failure, not success.
+ */
+#ifndef POLARIS_A630_GMU_H
+#define POLARIS_A630_GMU_H
+#ifndef POLARIS_A630_TCM_H
+#error Include Polaris TCM definitions first
+#endif
+enum a630_gmu_result {
+    A630_GMU_DISABLED, A630_GMU_ARGUMENT, A630_GMU_LEASE,
+    A630_GMU_IO, A630_GMU_RUNNING, A630_GMU_RESET_TIMEOUT,
+    A630_GMU_LOADED, A630_GMU_TRANSFER_FAILED
+};
+struct a630_gmu_snapshot {
+    uint32_t result, stage, retain_block_reset, polls;
+    uint32_t reset_before, reset_held, fw_init, hfi, counter;
+    struct a630_tcm_snapshot tcm;
+};
+static inline enum a630_gmu_result
+a630_gmu_prepare(bool board, bool hash_verified, const struct a630_image *image,
+    const struct a630_tcm_io *io, void (*wait)(void *, uint32_t), void *ctx,
+    struct a630_gmu_snapshot *s)
+{
+    if (!s) return A630_GMU_ARGUMENT;
+    *s = (struct a630_gmu_snapshot){0};
+    if (!board || !hash_verified) return A630_GMU_DISABLED;
+    if (!io || !io->admitted || !io->read || !io->write || !io->sync || !wait ||
+        !image || !image->data || image->bytes != A630_GMU_FLAT_BYTES) {
+        s->result = A630_GMU_ARGUMENT; return A630_GMU_ARGUMENT;
+    }
+    if (!io->admitted(ctx)) { s->result = A630_GMU_LEASE; return A630_GMU_LEASE; }
+    s->stage = 1;
+    if (!io->read(ctx, 0x14000, &s->reset_before) ||
+        !io->read(ctx, 0x14070, &s->fw_init) ||
+        !io->read(ctx, 0x14600, &s->hfi) ||
+        !io->read(ctx, 0x14220, &s->counter)) {
+        s->result = A630_GMU_IO; return A630_GMU_IO;
+    }
+    if (s->fw_init == 0xbabeface || s->hfi & 1u) {
+        s->result = A630_GMU_RUNNING; return A630_GMU_RUNNING;
+    }
+    s->stage = 2;
+    if (!io->admitted(ctx)) { s->result = A630_GMU_LEASE; return A630_GMU_LEASE; }
+    s->retain_block_reset = 1; /* Includes failed or posted reset writes. */
+    if (!io->write(ctx, 0x14000, 1) || !io->sync(ctx)) {
+        s->result = A630_GMU_IO; return A630_GMU_IO;
+    }
+    for (unsigned n = 0; n < 1000; n++) {
+        if (!io->admitted(ctx)) { s->result = A630_GMU_LEASE; return A630_GMU_LEASE; }
+        s->polls++;
+        if (!io->read(ctx, 0x14000, &s->reset_held)) {
+            s->result = A630_GMU_IO; return A630_GMU_IO;
+        }
+        if (s->reset_held == 1) break;
+        wait(ctx, 1);
+    }
+    if (s->reset_held != 1) {
+        s->result = A630_GMU_RESET_TIMEOUT; return A630_GMU_RESET_TIMEOUT;
+    }
+    s->stage = 3;
+    if (a630_tcm_load(board, hash_verified, image, io, ctx, &s->tcm) != A630_TCM_VERIFIED) {
+        s->result = A630_GMU_TRANSFER_FAILED; return A630_GMU_TRANSFER_FAILED;
+    }
+    s->stage = 4; s->result = A630_GMU_LOADED; return A630_GMU_LOADED;
+}
+#endif
--- /dev/null
+++ b/bsd/dev/polaris_dwc3_clock.h
@@ -0,0 +1,112 @@
+/* Polaris live DT requests snps,disable-clk-gating. Original MiCode
+ * c7cb50c1 core.c sets GCTL.DSBLCLKGTNG for the internal-RAM clock erratum.
+ * The admitted caller owns controller startup and supplies MMIO barriers.
+ * Keep the request on for a working gadget. Undo only our newly set bit,
+ * on a halted controller with no outstanding endpoint command.
+ */
+#ifndef POLARIS_DWC3_CLOCK_H
+#define POLARIS_DWC3_CLOCK_H
+#ifndef POLARIS_DWC3_COMMAND_H
+#error Include Polaris DWC3 command definitions first
+#endif
+#include <stdbool.h>
+
+#define PDWC3_GATE_GCTL 0xc110u
+#define PDWC3_GATE_DCTL 0xc704u
+#define PDWC3_GATE_DSTS 0xc70cu
+#define PDWC3_GATE_DISABLE 1u
+#define PDWC3_GATE_POLLS 1000u
+enum pdwc3_gate_error {
+    PDWC3_GATE_OK, PDWC3_GATE_ARGUMENT, PDWC3_GATE_UNSAFE,
+    PDWC3_GATE_ACK_TIMEOUT, PDWC3_GATE_RESTORE_TIMEOUT, PDWC3_GATE_COMMAND_ACTIVE
+};
+struct pdwc3_gate {
+    uint32_t error, start_error, attempted, changed, restored;
+    uint32_t before, live, after, dctl, dsts, busy_ep, busy_command;
+    uint32_t reads, writes, polls, restore_polls;
+};
+
+static inline uint32_t pdwc3_gate_read(const struct pdwc3_io *io,
+                                     struct pdwc3_gate *s, uint32_t off)
+{
+    s->reads++;
+    return io->read(io->ctx, off);
+}
+static inline bool pdwc3_gate_halted(const struct pdwc3_io *io, struct pdwc3_gate *s)
+{
+    s->dctl = pdwc3_gate_read(io, s, PDWC3_GATE_DCTL);
+    s->dsts = pdwc3_gate_read(io, s, PDWC3_GATE_DSTS);
+    return !(s->dctl & ((1u << 31) | (1u << 30))) && (s->dsts & (1u << 22));
+}
+static inline bool pdwc3_gate_device(uint32_t gctl)
+{
+    return ((gctl >> 12) & 3u) == 2 && !(gctl & (1u << 11));
+}
+static inline enum pdwc3_gate_error
+polaris_dwc3_clock_begin(const struct pdwc3_io *io, bool admitted, struct pdwc3_gate *s)
+{
+    if (!s) return PDWC3_GATE_ARGUMENT;
+    *s = (struct pdwc3_gate){.error=PDWC3_GATE_ARGUMENT,
+        .start_error=PDWC3_GATE_ARGUMENT, .busy_ep=UINT32_MAX};
+    if (!io || !io->read || !io->write || !io->wait_us) return PDWC3_GATE_ARGUMENT;
+    s->start_error = PDWC3_GATE_OK;
+    if (!admitted) { s->error = s->start_error = PDWC3_GATE_UNSAFE; return PDWC3_GATE_UNSAFE; }
+    s->attempted = 1;
+    if (!pdwc3_gate_halted(io, s)) { s->error = s->start_error = PDWC3_GATE_UNSAFE; return PDWC3_GATE_UNSAFE; }
+    s->before = pdwc3_gate_read(io, s, PDWC3_GATE_GCTL);
+    if (!pdwc3_gate_device(s->before)) { s->error = s->start_error = PDWC3_GATE_UNSAFE; return PDWC3_GATE_UNSAFE; }
+    s->changed = !(s->before & PDWC3_GATE_DISABLE);
+    if (s->changed) {
+        s->writes++;
+        io->write(io->ctx, PDWC3_GATE_GCTL, s->before | PDWC3_GATE_DISABLE);
+    }
+    for (unsigned i = 0; i < PDWC3_GATE_POLLS; i++) {
+        s->polls++;
+        s->live = pdwc3_gate_read(io, s, PDWC3_GATE_GCTL);
+        s->after = s->live;
+        if (!pdwc3_gate_device(s->live)) {
+            s->error = s->start_error = PDWC3_GATE_UNSAFE; return PDWC3_GATE_UNSAFE;
+        }
+        if (s->live & PDWC3_GATE_DISABLE) { s->error = PDWC3_GATE_OK; return PDWC3_GATE_OK; }
+        io->wait_us(io->ctx, 1);
+    }
+    s->error = s->start_error = PDWC3_GATE_ACK_TIMEOUT; return PDWC3_GATE_ACK_TIMEOUT;
+}
+
+static inline enum pdwc3_gate_error
+polaris_dwc3_clock_restore(const struct pdwc3_io *io, struct pdwc3_gate *s)
+{
+    if (!s || !io || !io->read || !io->write || !io->wait_us) return PDWC3_GATE_ARGUMENT;
+    s->restored = s->restore_polls = 0;
+    s->busy_ep = UINT32_MAX; s->busy_command = 0;
+    if (!s->attempted || !pdwc3_gate_halted(io, s)) {
+        s->error = PDWC3_GATE_UNSAFE; return PDWC3_GATE_UNSAFE;
+    }
+    uint32_t current = pdwc3_gate_read(io, s, PDWC3_GATE_GCTL);
+    s->after = current;
+    if (!pdwc3_gate_device(current)) { s->error = PDWC3_GATE_UNSAFE; return PDWC3_GATE_UNSAFE; }
+    if (!s->changed) { s->restored = 1; s->error = s->start_error; return PDWC3_GATE_OK; }
+    /* All used physical endpoints0..5 are halted before startup rollback.
+     * Never re-enable gating underneath a timed-out active command. Keep
+     * the owned request and report retention rather than false cleanup. */
+    for (unsigned ep = 0; ep < 6; ep++) {
+        uint32_t command = pdwc3_gate_read(io, s, 0xc80cu + 16u * ep);
+        if (command & PDWC3_CMDACT) {
+            s->busy_ep = ep; s->busy_command = command;
+            s->error = PDWC3_GATE_COMMAND_ACTIVE; return PDWC3_GATE_COMMAND_ACTIVE;
+        }
+    }
+    s->writes++;
+    io->write(io->ctx, PDWC3_GATE_GCTL, current & ~PDWC3_GATE_DISABLE);
+    for (unsigned i = 0; i < PDWC3_GATE_POLLS; i++) {
+        s->restore_polls++;
+        s->after = pdwc3_gate_read(io, s, PDWC3_GATE_GCTL);
+        if (!pdwc3_gate_device(s->after)) { s->error = PDWC3_GATE_UNSAFE; return PDWC3_GATE_UNSAFE; }
+        if (!(s->after & PDWC3_GATE_DISABLE)) {
+            s->restored = 1; s->error = s->start_error; return PDWC3_GATE_OK;
+        }
+        io->wait_us(io->ctx, 1);
+    }
+    s->error = PDWC3_GATE_RESTORE_TIMEOUT; return PDWC3_GATE_RESTORE_TIMEOUT;
+}
+#endif
