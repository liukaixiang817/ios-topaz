+    return version && sha &&
+        ((bytes==7 && !__builtin_memcmp(version,"20H392",7)) ||
+         (bytes==6 && !__builtin_memcmp(version,"20F66",6) && !__builtin_memcmp(sha,f66_sha,32)));
+}
