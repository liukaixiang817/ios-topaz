+static int
+polaris_file_root_init(void)
+{
+    uint32_t enabled = 0, probe = 0, rw = 0, rootrw = 0;
+    PE_parse_boot_argn("polarisfileroot", &enabled, sizeof(enabled));
+    PE_parse_boot_argn("polarisufsprobe", &probe, sizeof(probe));
+    PE_parse_boot_argn("ufsrw", &rw, sizeof(rw));
+    PE_parse_boot_argn("rootrw", &rootrw, sizeof(rootrw));
+    if (enabled != 1 || probe || rw || rootrw) {
+        printf("POLARIS FILE ROOT: disabled or conflicting boot arguments\n");
+        return ENXIO;
+    }
+    DTEntry node;
+    uint64_t reg[2], layout[3]; /* partition start/count, file blocks */
+    uint32_t version, crc[3]; /* GPT head, first and last 4KiB image blocks */
+    void const *extents = NULL;
+    unsigned size = 0;
+    if (SecureDTLookupEntry(NULL, "/polaris-file-root", &node) != kSuccess ||
+        !polaris_dt_copy(node, "reg", reg, sizeof(reg)) ||
+        reg[0] != 0x1d84000 || reg[1] != 0x2500 ||
+        !polaris_dt_copy(node, "version", &version, sizeof(version)) || version != 1 ||
+        !polaris_dt_copy(node, "layout", layout, sizeof(layout)) ||
+        !polaris_dt_copy(node, "crc32", crc, sizeof(crc)) ||
+        SecureDTGetProperty(node, "extents", &extents, &size) != kSuccess ||
+        !size || size % sizeof(struct polaris_extent) || size > sizeof(polaris_file_map)) {
+        printf("POLARIS FILE ROOT: REFUSED metadata; no MMIO\n");
+        return EINVAL;
+    }
+    polaris_file_count = size / sizeof(struct polaris_extent);
+    memcpy(polaris_file_map, extents, size);
+    if (!polaris_map_valid(polaris_file_map, polaris_file_count,
+        layout[2], layout[0], layout[1])) {
+        printf("POLARIS FILE ROOT: REFUSED extent geometry; no MMIO\n");
+        return EINVAL;
+    }
+    lck_mtx_lock(&sweet_ufs_lock);
+    int error = ENXIO;
+    if (su.regs || su.dma) { goto out; }
+    su.regs = ml_io_map(reg[0], reg[1]);
+    if (!su.regs) { goto out; }
+    if (ufs_rd(0x08) != 0x210 || !(ufs_rd(REG_HCE) & 1) ||
+        (ufs_rd(REG_HCS) & (HCS_DP | HCS_UTRLRDY)) != (HCS_DP | HCS_UTRLRDY) ||
+        ufs_rd(REG_UTRLDBR) || ufs_rd(0x78) || ufs_rd(0x80)) {
+        printf("POLARIS FILE ROOT: REFUSED host/link/queue state\n");
+        goto out;
+    }
+    if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+        KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+        error = ENOMEM;
+        goto out;
+    }
+    ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)su.dma);
+    if (!pn) { error = ENOMEM; goto out; }
+    su.dma_pa = ptoa_64(pn);
+    su.lun = 0;
+    su.cache = su.writable = su.ready = false;
+    su.wait = true;
+    su.secsize = DEV_BSIZE;
+    error = ufs_take_over_host();
+    if (!error) {
+        static const uint8_t tur[6] = {0};
+        for (unsigned i = 0; i < 3; i++) {
+            error = ufs_scsi(tur, sizeof(tur), 0, false);
+            if (!error || error == ETIMEDOUT) { break; }
+        }
+    }
+    if (!error) { error = ufs_read_blocks(0, 256); }
+    if (error) { goto out; }
+    const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+    if (polaris_probe_crc32(b, BOUNCE_SIZE) != crc[0] ||
+        !polaris_userdata_bounds(b, layout[0], layout[1])) {
+        printf("POLARIS FILE ROOT: REFUSED GPT/partition mismatch\n");
+        error = EINVAL;
+        goto out;
+    }
+    /* The CDB allowlist opens ONLY after geometry and on-device GPT agree.
+     * This never allows WRITE(10), cache flush, UNMAP or raw partition access. */
+    polaris_file_active = true;
+    for (unsigned i = 0; i < 2; i++) {
+        uint64_t physical;
+        uint32_t blocks;
+        if (!polaris_map_read(polaris_file_map, polaris_file_count,
+            i ? layout[2] - 1 : 0, 1, &physical, &blocks)) {
+            error = EINVAL; goto out;
+        }
+        error = ufs_read_blocks(physical, blocks);
+        if (error) { goto out; }
+        if (polaris_probe_crc32(b, UFS_BLOCK) != crc[i + 1]) {
+            printf("POLARIS FILE ROOT: REFUSED image edge %u CRC mismatch\n", i);
+            error = EINVAL; goto out;
+        }
+        if (!i) {
+            const uint8_t *h = b + 1024;
+            uint32_t block_size = (uint32_t)h[40] << 24 | (uint32_t)h[41] << 16 |
+                (uint32_t)h[42] << 8 | h[43];
+            uint32_t total = (uint32_t)h[44] << 24 | (uint32_t)h[45] << 16 |
+                (uint32_t)h[46] << 8 | h[47];
+            if (h[0] != 'H' || h[1] != 'X' || h[2] || h[3] != 5 ||
+                block_size != UFS_BLOCK || total != layout[2]) {
+                printf("POLARIS FILE ROOT: REFUSED HFSX geometry\n");
+                error = EINVAL; goto out;
+            }
+        }
+    }
+    su.first_block = 0; /* Logical image offset; translated per request. */
+    su.nblocks = layout[2];
+    su.bmajor = bdevsw_add(-1, &sweet_ufs_bdevsw);
+    if (su.bmajor < 0) { error = ENXIO; goto out; }
+    su.cmajor = cdevsw_add_with_bdev(-1, &sweet_ufs_cdevsw, su.bmajor);
+    if (su.cmajor < 0) { error = ENXIO; goto out; }
+    su.bdev = makedev(su.bmajor, 0);
+    devfs_make_node(su.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0400, "ufsroot0");
+    devfs_make_node(makedev(su.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0400, "rufsroot0");
+    su.ready = true;
+    printf("POLARIS FILE ROOT: verified GPT + HFSX, %llu MiB, %u extents, READ ONLY\n",
+        su.nblocks * UFS_BLOCK >> 20, polaris_file_count);
+out:
+    if (error) {
+        polaris_file_active = false;
+        printf("POLARIS FILE ROOT: stopped, error %d; DMA retained\n", error);
+    }
+    /* No firmware reset or DMA free, including on timeout. No topaz input,
+     * USB, sampling or disk-backed console logger is started here. */
+    lck_mtx_unlock(&sweet_ufs_lock);
+    return error;
+}
