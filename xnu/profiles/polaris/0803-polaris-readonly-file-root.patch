+#if defined(POLARIS_RAM_ONLY)
+/* Exact-size DT reads avoid unaligned native-pointer dereferences. */
+static bool
+polaris_dt_copy(DTEntry node, const char *name, void *out, unsigned length)
+{
+    void const *property = NULL;
+    unsigned size = 0;
+    if (SecureDTGetProperty(node, name, &property, &size) != kSuccess || size != length) {
+        return false;
+    }
+    memcpy(out, property, length);
+    return true;
+}
