+static struct polaris_usb_snapshot polaris_usb_saved;
+static unsigned polaris_usb_mode;
+static uint32_t polaris_usb_published;
+static uint32_t polaris_usb_attempted;
+struct polaris_usb_io { vm_offset_t base[2]; };
+
+static bool
+polaris_usb_read_register(void *opaque, unsigned region, uint32_t off, uint32_t *value)
+{
+    struct polaris_usb_io *io = (struct polaris_usb_io *)opaque;
+    if (region > 1 || (off & 3)) return false;
+    const uint32_t size = region ? POLARIS_USB_CORE_SIZE : POLARIS_USB_GCC_SIZE;
+    if (off > size - 4) return false;
+    if (!io->base[region]) {
+        io->base[region] = ml_io_map(region ? POLARIS_USB_CORE : POLARIS_USB_GCC, size);
+        if (!io->base[region]) return false;
+    }
+    *value = usb_rd(io->base[region], off);
+    return true;
+}
+
+static bool
+polaris_usb_dt_reg(DTEntry node, const char *key, uint64_t address, uint64_t length)
+{
+    void const *p = NULL;
+    unsigned n = 0;
+    uint64_t reg[2];
+    if (SecureDTGetProperty(node, key, &p, &n) != kSuccess || n != sizeof(reg)) return false;
+    memcpy(reg, p, sizeof(reg));
+    return reg[0] == address && reg[1] == length;
+}
+
+void polaris_usb_report(void);
+void polaris_usb_init(void);
+
+void
+polaris_usb_report(void)
+{
+    if (!__atomic_load_n(&polaris_usb_published, __ATOMIC_ACQUIRE)) return;
+    const struct polaris_usb_snapshot *s = &polaris_usb_saved;
+    printf("D USB: mode=%u result=%u reads=%u id=%x gctl=%x dctl=%x dsts=%x\n",
+        polaris_usb_mode, s->result, s->reads, s->id, s->gctl, s->dctl, s->dsts);
+    printf("D UCLK: gdsc=%x master=%x sleep=%x utmi=%x noc=%x axi=%x phy=%x ref=%x\n",
+        s->gdscr, s->clocks[0], s->clocks[1], s->clocks[2], s->clocks[3],
+        s->clocks[4], s->clocks[5], s->clocks[6]);
+}
+
+void
+polaris_usb_init(void)
+{
+    unsigned mode = 0, size = 0;
+    uint32_t version = 0;
+    DTEntry node;
+    void const *p = NULL;
+    PE_parse_boot_argn("polarisusb", &mode, sizeof(mode));
+    if (mode != 1 && mode != 2) return;
+    if (__atomic_exchange_n(&polaris_usb_attempted, 1, __ATOMIC_ACQ_REL)) return;
+    bool board = SecureDTLookupEntry(NULL, "/polaris-usb", &node) == kSuccess &&
+        SecureDTGetProperty(node, "version", &p, &size) == kSuccess && size == sizeof(version);
+    if (board) memcpy(&version, p, sizeof(version));
+    board = board && version == 1 &&
+        polaris_usb_dt_reg(node, "reg", POLARIS_USB_CORE, POLARIS_USB_CORE_SIZE) &&
+        polaris_usb_dt_reg(node, "gcc-reg", POLARIS_USB_GCC, POLARIS_USB_GCC_SIZE) &&
+        polaris_usb_dt_reg(node, "scratch-reg", POLARIS_USB_SCRATCH, POLARIS_USB_SCRATCH_SIZE);
+    struct polaris_usb_io io = {{0, 0}};
+    struct polaris_usb_snapshot snapshot;
+    enum polaris_usb_result result = polaris_usb_probe(mode, board,
+        polaris_usb_read_register, &io, &snapshot);
+    polaris_usb_saved = snapshot;
+    polaris_usb_mode = mode;
+    __atomic_store_n(&polaris_usb_published, 1, __ATOMIC_RELEASE);
+    printf("POLARIS USB: board=%u mode=%u result=%u; no clock/PHY power-up\n", board, mode, result);
+    polaris_usb_report();
+    if (result == POLARIS_USB_READY && mode == 2) {
+        /* Only a verified halted DWC3 in device mode reaches the existing
+         * volatile gadget setup. DMA stays in RAM; no storage or shell API. */
+        sweet_usb_gadget_start(io.base[1]);
+    }
+}
