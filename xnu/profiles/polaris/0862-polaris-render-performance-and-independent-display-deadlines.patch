+    uint64_t total=0,idle=(uint32_t)(after[2]-before[2]);
+    for(unsigned i=0;i<4;i++)total+=(uint32_t)(after[i]-before[i]);
+    return total?(uint32_t)((total-idle)*10000/total):10001;
