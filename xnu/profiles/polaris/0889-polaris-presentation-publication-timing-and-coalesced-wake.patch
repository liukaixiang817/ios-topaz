+/* Called only by the existing opt-in generic-VM cache probe. Real native
+ * workloop/event-source delivery, not a display/GPU or performance emulator. */
+struct PfbWakeProbe {
+    IOLock *lock;
+    IOWorkLoop *loop;
+    IOInterruptEventSource *source;
+    struct pfb_queue queue;
+    uint64_t latest;
+    unsigned callbacks,taken,empty,pokes,error;
+};
+static void pfb_probe_callback(OSObject *owner,IOInterruptEventSource *,int count)
+{
+    PfbWakeProbe *p=(PfbWakeProbe *)((OSData *)owner)->getBytesNoCopy();
+    IOLockLock(p->lock);
+    if(count!=1 || !p->loop->onThread() || !p->loop->inGate())p->error=1;
+    pfb_wake_consumed(&p->queue);p->callbacks++;
+    struct pfb_publication publication={};
+    if(pfb_take(&p->queue,&publication)) {
+        if(publication.sequence<=p->latest)p->error=2;
+        p->latest=publication.sequence;p->taken++;
+        /* A publication arriving during delivery must schedule another pass,
+         * not disappear when checkForWork commits its consumer snapshot. */
+        if(publication.sequence==100) {
+            if(!pfb_publish(&p->queue,101,101,true))p->error=3;
+            else {p->pokes++;p->source->interruptOccurred(NULL,NULL,0);}
+        }
+    }else p->empty++;
+    IOLockUnlock(p->lock);
+}
+static IOReturn pfb_probe_burst(OSObject *owner,void *,void *,void *,void *)
+{
+    PfbWakeProbe *p=(PfbWakeProbe *)((OSData *)owner)->getBytesNoCopy();
+    if(!p->loop->inGate() || p->loop->onThread())return kIOReturnError;
+    IOLockLock(p->lock);
+    unsigned before=p->callbacks;
+    for(unsigned n=0;n<100;n++) {
+        uint64_t next=p->queue.sequence+1;
+        if(pfb_publish(&p->queue,next,(uint32_t)next,true)) {
+            p->pokes++;p->source->interruptOccurred(NULL,NULL,0);
+        }
+    }
+    if(p->callbacks!=before)p->error=4; /* no inline producer-thread copy */
+    IOLockUnlock(p->lock);return kIOReturnSuccess;
+}
+static bool pfb_probe_wait(PfbWakeProbe *p,unsigned callbacks,uint64_t latest)
+{
+    /* A timeout is a failure, never evidence of delivery/drain. */
+    for(unsigned n=0;n<2000;n++) {
+        IOLockLock(p->lock);
+        bool done=p->callbacks==callbacks && p->latest==latest;
+        bool failed=p->error!=0;
+        IOLockUnlock(p->lock);
+        if(failed)return false;
+        if(done)return true;
+        IOSleep(1);
+    }
+    return false;
+}
+extern "C" int PolarisFramebufferWakeProbe(void)
+{
+    int error=0;bool attached=false;
+    IOLock *lock=IOLockAlloc();IOWorkLoop *loop=IOWorkLoop::workLoop();
+    struct PfbWakeProbe initial={};initial.lock=lock;initial.loop=loop;
+    OSData *owner=OSData::withBytes(&initial,sizeof(initial));
+    IOInterruptEventSource *source=NULL;
+    PfbWakeProbe *p=owner?(PfbWakeProbe *)owner->getBytesNoCopy():NULL;
+    unsigned callbacks=0,taken=0,empty=0,pokes=0;uint64_t latest=0;
+    if(!lock || !loop || !owner){error=1;goto cleanup;}
+    source=IOInterruptEventSource::interruptEventSource(owner,pfb_probe_callback);
+    if(!source || source->getProvider()!=NULL){error=2;goto cleanup;}
+    p->source=source;
+    if(loop->addEventSource(source)!=kIOReturnSuccess){error=3;goto cleanup;}
+    attached=true;
+    if(loop->runAction(pfb_probe_burst,owner)!=kIOReturnSuccess ||
+        !pfb_probe_wait(p,2,101)){error=4;goto cleanup;}
+    if(loop->runAction(pfb_probe_burst,owner)!=kIOReturnSuccess ||
+        !pfb_probe_wait(p,3,201)){error=5;goto cleanup;}
+    IOLockLock(lock);source->interruptOccurred(NULL,NULL,0);IOLockUnlock(lock);
+    if(!pfb_probe_wait(p,4,201)){error=6;goto cleanup;}
+cleanup:
+    if(attached) {source->disable();loop->removeEventSource(source);}
+    if(p) {
+        callbacks=p->callbacks;taken=p->taken;empty=p->empty;
+        pokes=p->pokes;latest=p->latest;if(!error)error=p->error;
+    }
+    if(!error && (callbacks!=4 || taken!=3 || empty!=1 || pokes!=3 || latest!=201))error=7;
+    OSSafeReleaseNULL(source);OSSafeReleaseNULL(owner);OSSafeReleaseNULL(loop);
+    if(lock)IOLockFree(lock);
+    IOLog("POLARIS PFB VM: %s callbacks=%u taken=%u empty=%u pokes=%u latest=%llu error=%d; actual native workloop, no panel/GPU\n",
+        error?"FAIL":"PASS",callbacks,taken,empty,pokes,latest*1ull,error);
+    return error;
+}
