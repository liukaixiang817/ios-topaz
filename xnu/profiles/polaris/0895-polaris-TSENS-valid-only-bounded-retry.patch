+static bool polaris_tsens_retry_vm_read(void *v,uint32_t offset,uint32_t *out)
+{
+    struct polaris_tsens_retry_vm *s=(struct polaris_tsens_retry_vm *)v;
+    if(s->slot>=12 || offset!=0xbc+(s->slot%6)*4)return false;
+    ++s->reads;if(s->fail==s->reads)return false;
