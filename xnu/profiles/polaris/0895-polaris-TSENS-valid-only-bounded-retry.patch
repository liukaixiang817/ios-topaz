+    if(s->critical){*out|=1u<<19;return true;}
+    if(s->attempt++<s->invalid)return true;
+    *out|=1u<<21;s->slot++;s->attempt=0;return true;
+}
+static uint64_t polaris_tsens_retry_vm_now(void *v)
