-        conduit = polaris_uefi_psci_conduit(mode, boot, count,
+        conduit = polaris_uefi_psci_running_conduit(mode, boot, count,
             __builtin_arm_rsr64("MPIDR_EL1"));
         if (conduit < 0) panic("POLARIS UEFI: unbound PSCI conduit");
     }
