+/* Caller serializes this with every read/write/trim and arena reservation. */
+static inline unsigned polaris_cow_available(struct polaris_cow *c)
+{
+    if(!c||c->used>c->limit)return 0;
+    if(!c->discard)return c->limit-c->used;
+    if(!polaris_discard_valid(c->discard,c->nblocks)||c->discard->reusable>c->used||
+       c->discard->free_head>c->used||((c->discard->free_head!=0)!=(c->discard->reusable!=0)))return 0;
+    return c->limit-c->used+c->discard->reusable;
+}
+static inline struct polaris_cow_group *polaris_cow_ensure(struct polaris_cow *c,
+    uint64_t number,polaris_cow_alloc allocate,void *context)
+{
+    struct polaris_cow_group *g=polaris_cow_find(c,number);
+    if(g)return g;
+    if(!allocate||!polaris_cow_available(c))return NULL;
+    uint32_t index;
+    if(c->discard&&c->discard->free_head) {
+        index=c->discard->free_head-1;g=&c->groups[index];
+        if(!g->data||g->valid||g->number!=UINT64_MAX||g->next>c->used||!c->discard->reusable)return NULL;
+        c->discard->free_head=g->next;c->discard->reusable--;c->discard->reused_groups++;
+    } else {
+        uint8_t *data=allocate(POLARIS_COW_BYTES,context);if(!data)return NULL;
+        index=c->used++;g=&c->groups[index];g->data=data;
+    }
+    g->number=number;g->valid=0;unsigned bucket=(unsigned)(number%POLARIS_COW_BUCKETS);
+    g->next=c->buckets[bucket];c->buckets[bucket]=index+1;
+    return g;
+}
+/* Only an already validated whole ioctl may call this. Fully empty groups
+ * retain their RAM data and reuse the EXISTING BSS next field as a free link. */
+static inline bool polaris_cow_discard(struct polaris_cow *c,unsigned count,
+    const struct polaris_ram_trim_extent *extents)
+{
+    if(!c||!polaris_discard_extents_valid(c->discard,c->nblocks,count,extents)||
+       c->used>c->limit||c->discard->free_head>c->used||c->discard->reusable>c->used)return false;
+    /* Validate complete hash/free membership once before logical mutation.
+     * visited is bounded arena scratch, not the tombstone or file data. */
+    __builtin_memset(c->discard->visited,0,sizeof(c->discard->visited));
+    unsigned seen=0,free_count=0;uint64_t dirty=0;
+    for(unsigned bucket=0;bucket<POLARIS_COW_BUCKETS;bucket++) {
+        uint32_t index=c->buckets[bucket];
+        while(index) {
+            if(index>c->used||seen==c->used)return false;
+            unsigned bit=index-1;uint8_t mask=(uint8_t)(1u<<(bit%8));
+            if(c->discard->visited[bit/8]&mask)return false;
+            c->discard->visited[bit/8]|=mask;seen++;
+            const struct polaris_cow_group *g=&c->groups[bit];
+            if(!g->data||g->valid>15||g->number>=(c->nblocks+3)/4||
+               g->number%POLARIS_COW_BUCKETS!=bucket)return false;
+            dirty+=(unsigned)__builtin_popcount((unsigned)g->valid);index=g->next;
+        }
+    }
+    for(uint32_t index=c->discard->free_head;index;) {
+        if(index>c->used||seen==c->used)return false;
+        unsigned bit=index-1;uint8_t mask=(uint8_t)(1u<<(bit%8));
+        if(c->discard->visited[bit/8]&mask)return false;
+        c->discard->visited[bit/8]|=mask;seen++;free_count++;
+        const struct polaris_cow_group *g=&c->groups[bit];
+        if(!g->data||g->valid||g->number!=UINT64_MAX)return false;
+        index=g->next;
+    }
+    if(seen!=c->used||free_count!=c->discard->reusable||dirty!=c->dirty_blocks)return false;
+    /* Byte-bounded bitmap update; a full16GiB discard does not walk millions
+     * of empty hash lookups. At most512KiB bitmap work + the existing table. */
+    for(unsigned i=0;i<count;i++) {
+        uint64_t first=extents[i].offset/POLARIS_COW_BLOCK;
+        uint64_t last=first+extents[i].length/POLARIS_COW_BLOCK;
+        for(uint64_t byte=first/8;byte<=(last-1)/8;byte++) {
+            unsigned low=byte==first/8?(unsigned)(first%8):0;
+            unsigned high=byte==(last-1)/8?(unsigned)((last-1)%8)+1:8;
+            uint8_t mask=(uint8_t)(((1u<<high)-1u)&~((1u<<low)-1u));
+            uint8_t before=c->discard->zeroes[byte];
+            unsigned added=(unsigned)__builtin_popcount((unsigned)(mask&(uint8_t)~before));
+            c->discard->trimmed_blocks+=added;c->discard->zero_blocks+=added;
+            c->discard->zeroes[byte]=before|mask;
+        }
+    }
+    for(unsigned index=0;index<c->used;index++) {
+        struct polaris_cow_group *g=&c->groups[index];
+        if(g->number==UINT64_MAX)continue;
+        for(unsigned slot=0;slot<4;slot++) {
+            uint8_t bit=(uint8_t)(1u<<slot);
+            if((g->valid&bit)&&polaris_discard_zero(c->discard,g->number*4+slot)) {
+                g->valid&=(uint8_t)~bit;c->dirty_blocks--;
+            }
+        }
+        if(!g->valid) {
+            uint32_t *link=&c->buckets[g->number%POLARIS_COW_BUCKETS];
+            while(*link && &c->groups[*link-1]!=g)link=&c->groups[*link-1].next;
+            *link=g->next;g->number=UINT64_MAX;
+            g->next=c->discard->free_head;c->discard->free_head=index+1;
+            c->discard->reusable++;c->discard->recycled_groups++;
+        }
+    }
+    c->discard->calls++;return true;
+}
