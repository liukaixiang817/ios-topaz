+/* Store-only LCD blanking. The scanout mapping is WC, so reading every
+ * pixel to emulate an AMOLED fade stalls the workloop for multiple frames.
+ * Bounds are checked before any store; this does NOT turn off a backlight. */
+static bool polaris_fb_black_frame(uintptr_t pixels,uint64_t bytes,
+    uint32_t width,uint32_t height,uint32_t stride)
+{
+    if(!pixels || (pixels&3) || !width || !height || width>1080 || height>2160 ||
+       (stride&3) || stride<(uint64_t)width*4 || bytes<(uint64_t)stride*height ||
+       bytes>UINTPTR_MAX-pixels)return false;
+    for(uint32_t y=0;y<height;y++) {
+        volatile uint32_t *row=(volatile uint32_t *)(pixels+(uint64_t)y*stride);
+        for(uint32_t x=0;x<width;x++)row[x]=0;
+    }
+    return true;
+}
