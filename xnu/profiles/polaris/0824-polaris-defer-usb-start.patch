+#if defined(POLARIS_RAM_ONLY)
+static void
+polaris_usb_worker(void *arg, wait_result_t wr __unused)
+{
+    PU_PROGRESS(PU_WORKER, 0);
+    if (arg == NULL) {
+        int err = ud_if_create();
+        printf("POLARIS USB NETTEST: %s error=%d; no MMIO or DMA\n", err ? "FAIL" : "PASS", err);
+    } else {
+        sweet_usb_gadget_start((vm_offset_t)arg);
+    }
+    thread_terminate(current_thread());
+}
+static void
+polaris_usb_schedule(vm_offset_t dwc)
+{
+    if (__atomic_exchange_n(&polaris_usb_worker_started, 1, __ATOMIC_ACQ_REL)) return;
+    PU_PROGRESS(PU_QUEUED, 0);
+    thread_t worker;
+    kern_return_t kr = kernel_thread_start(polaris_usb_worker, (void *)dwc, &worker);
+    if (kr == KERN_SUCCESS) thread_deallocate(worker);
+    else PU_PROGRESS(PU_QUEUED, kr);
+}
+void polaris_usb_network_test(unsigned);
+void
+polaris_usb_network_test(unsigned mode)
+{
+    if (mode == 1) polaris_usb_schedule(0);
+    else {
+        /* Deliberately retain the old synchronous call context as a
+         * hardware-free diagnostic comparison, never the phone profile. */
+        PU_PROGRESS(PU_WORKER, 0);
+        int err = ud_if_create();
+        printf("POLARIS USB NETTEST: %s error=%d; synchronous, no MMIO or DMA\n",
+            err ? "FAIL" : "PASS", err);
+    }
+}
