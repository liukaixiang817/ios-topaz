+        slide > 0x7fffffffffULL - slot ||
+        copyin((user_addr_t)(slot + slide), &message, sizeof(message)) || !message) { return; }
+    bzero(text, sizeof(text));
+    int error = copyinstr((user_addr_t)message, text, sizeof(text), &length);
+    if (error && error != ENAMETOOLONG) { return; }
+    text[sizeof(text) - 1] = 0;
+    for (unsigned i = 0; text[i]; i++) {
+        if ((unsigned char)text[i] < 0x20 || (unsigned char)text[i] > 0x7e) { text[i] = '.'; }
+    }
+    snprintf(line, sizeof(line), "D CRASH %s: %s", name, text);
+    polaris_diag_record(index, line);
