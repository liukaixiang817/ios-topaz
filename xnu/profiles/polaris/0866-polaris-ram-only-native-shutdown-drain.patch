+/* Opt-in RAM-only experiment in real BSD shutdown, separate from durable
+ * runtime permission. No UFS write gate is changed or cache-sync success
+ * fabricated. Only firmware/kernel-owned RAM is exposed. */
+struct polaris_shutdown_slot polaris_uefi_shutdown;
+static bool ps_enabled, ps_bsd_ready;
+void polaris_uefi_shutdown_ready(void)
+{
+    __atomic_store_n(&ps_bsd_ready,true,__ATOMIC_RELEASE);
+}
+static void ps_publish(unsigned phase,unsigned error)
+{
+    polaris_uefi_shutdown.kernel.error=error;
+    __atomic_store_n(&polaris_uefi_shutdown.kernel.phase,phase,__ATOMIC_RELEASE);
+    pi_cache((uintptr_t)&polaris_uefi_shutdown.kernel,true);
+}
+int polaris_uefi_shutdown_pending(void)
+{
+    return ps_enabled && __atomic_load_n(&polaris_uefi_shutdown.kernel.phase,__ATOMIC_ACQUIRE)==POLARIS_Q_REQUESTED;
+}
+int polaris_uefi_shutdown_finish(int howto,unsigned mounts,unsigned busy)
+{
+    if (!polaris_uefi_shutdown_pending()) { return ENOTSUP; }
+    if (howto || mounts || busy) {
+        printf("POLARIS UEFI DRAIN: refused howto=%x mounts=%u busy=%u\n",howto,mounts,busy);
+        ps_publish(POLARIS_Q_FAILED,EBUSY);return EBUSY;
+    }
+    printf("POLARIS UEFI DRAIN: actual VFS mounts=0 busy=0; RAM only, no UFS durability proof\n");
+    /* One logical XNU core only. No further kernel thread/interrupt can issue
+     * I/O after publication. Firmware remains independently alive on CPU0. */
+    __asm__ volatile("msr daifset,#15; dsb sy; isb":::"memory");
+    polaris_uefi_shutdown.kernel.capabilities=POLARIS_Q_RAM_DRAINED;
+    ps_publish(POLARIS_Q_SEALED,0);
+    for (;;) { __asm__ volatile("wfe":::"memory"); }
+}
+static void ps_thread(void *arg,wait_result_t result)
+{
+    (void)arg;(void)result;
+    while (!__atomic_load_n(&ps_bsd_ready,__ATOMIC_ACQUIRE)) { pt_wait(10); }
+    struct polaris_shutdown_slot *slot=&polaris_uefi_shutdown;
+    slot->kernel.cookie=mach_absolute_time()|UINT64_C(1);
+    slot->kernel.capabilities=POLARIS_Q_RAM_CONFIG;
+    ps_publish(POLARIS_Q_RUNNING,0);
+    printf("POLARIS UEFI DRAIN: RAM-only mailbox ready after BSD initialization\n");
+    for (;;) {
+        pi_cache((uintptr_t)&slot->firmware,false);
+        uint32_t sequence=__atomic_load_n(&slot->firmware.sequence,__ATOMIC_ACQUIRE);
+        if (sequence) {
+            unsigned mode=slot->firmware.mode;
+            bool canonical=true;
+            for (unsigned i=0;i<sizeof(slot->firmware.reserved);i++) {
+                if (slot->firmware.reserved[i]) { canonical=false; }
+            }
+            if (!canonical || slot->firmware.cookie!=slot->kernel.cookie || sequence!=1 || (mode!=1&&mode!=2)) {
+                printf("POLARIS UEFI DRAIN: refused noncanonical/replayed request\n");
+                ps_publish(POLARIS_Q_FAILED,EINVAL);break;
+            }
+            slot->kernel.sequence=sequence;slot->kernel.mode=mode;
+            ps_publish(POLARIS_Q_REQUESTED,0);
+            printf("POLARIS UEFI DRAIN: accepted seq=%u mode=%u; calling reboot_kernel sync path\n",sequence,mode);
+            int error=reboot_kernel(0,NULL);
+            /* The successful terminal hook parks the only XNU core forever.
+             * Return/error never grants durable or RAM-drained permission. */
+            ps_publish(POLARIS_Q_FAILED,error?error:EIO);break;
+        }
+        pt_wait(10);
+    }
+    (void)thread_terminate(current_thread());thread_block(THREAD_CONTINUE_NULL);
+}
+static void ps_start(void)
+{
+    uint32_t enabled=0,ram=0,rw=0,cpus=0;
+    PE_parse_boot_argn("polarisquiesce",&enabled,sizeof(enabled));
+    PE_parse_boot_argn("polarisramcow",&ram,sizeof(ram));
+    PE_parse_boot_argn("ufsrw",&rw,sizeof(rw));
+    PE_parse_boot_argn("cpus",&cpus,sizeof(cpus));
+    if (enabled!=1 || ram!=1 || rw || cpus!=1) { return; }
+    ps_enabled=true;thread_t thread;
+    kern_return_t kr=kernel_thread_start(ps_thread,NULL,&thread);
+    if (kr==KERN_SUCCESS) { thread_deallocate(thread); }
+    else { ps_enabled=false;printf("POLARIS UEFI DRAIN: thread failed %d\n",kr); }
+}
 static void pi_start(void)
 {
     uint32_t mode=0,input=0;
     PE_parse_boot_argn("polarisuefi",&mode,sizeof(mode));
     PE_parse_boot_argn("polarisinput",&input,sizeof(input));
     if (mode!=1 || input!=1) { return; }
+    ps_start();
     thread_t thread;
     kern_return_t kr=kernel_thread_start(pi_thread,NULL,&thread);
     if (kr==KERN_SUCCESS) { thread_deallocate(thread); }
