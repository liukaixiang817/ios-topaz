diff --git a/bsd/dev/polaris-wifi-glink.h b/bsd/dev/polaris-wifi-glink.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/polaris-wifi-glink.h
@@ -0,0 +1,75 @@
+/* Polaris legacy-SMEM GLINK/QRTR transport. See polaris-wifi-glink.c for
+ * Dipper original MIT notice and adaptation provenance. No hardware startup. */
+#ifndef POLARIS_WIFI_GLINK_H
+#define POLARIS_WIFI_GLINK_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include "polaris-glink-inventory.h"
+
+struct polaris_wifi_qrtr_port;
+typedef void (*polaris_wifi_qrtr_receive_t)(void *, uint32_t, uint32_t, const void *, size_t);
+typedef void (*polaris_wifi_qrtr_server_t)(void *, bool, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t);
+/* Same callback contract as the pinned HackiOS native QRTR interface. The
+ * caller can bridge it explicitly; do not cast foreign port objects. */
+struct polaris_wifi_qrtr_ops {
+    struct polaris_wifi_qrtr_port *(*open)(polaris_wifi_qrtr_receive_t, polaris_wifi_qrtr_server_t, void *);
+    int (*send)(struct polaris_wifi_qrtr_port *, uint32_t, uint32_t, const void *, size_t);
+    int (*lookup)(struct polaris_wifi_qrtr_port *, uint32_t, uint32_t, uint32_t);
+    void (*close)(struct polaris_wifi_qrtr_port *);
+};
+enum polaris_wifi_fault {
+    PWF_OK, PWF_SCOPE, PWF_BOUNDS, PWF_READ, PWF_CACHE, PWF_WRITE,
+    PWF_ORDER, PWF_RING, PWF_PROTOCOL, PWF_CLOCK, PWF_PENDING
+};
+struct polaris_wifi_glink_cfg {
+    uint64_t epoch, smem_phys;
+    uint32_t smem_bytes, local_node;
+    struct polaris_glink_layout layout;
+    /* Mandatory native lifetime/ownership gate. Must establish an existing own
+     * DT mapping of SMEM 0x86000000/2MiB, MPU access, exclusive APPS TX producer /
+     * RX consumer, stable selected inventory, remote lifecycle, and correct
+     * own doorbell ownership for this epoch. Inventory alone is insufficient.
+     * Must be read-only and fail on stale/unknown; never call SMEM Get/Alloc. */
+    bool (*scope)(void *, uint64_t, const struct polaris_glink_layout *);
+    bool (*smem_read)(void *, uint32_t, void *, uint32_t);
+    /* Success means known full 32-bit write; failure is uncertain and sticky. */
+    bool (*smem_write32)(void *, uint32_t, uint32_t);
+    bool (*invalidate)(void *, uint32_t, uint32_t);
+    /* Platform device/cache barrier, not merely a compiler barrier. */
+    bool (*order)(void *);
+    /* Own DT mpss route if this is its admitted edge (0x1799000c bit12),
+     * not a WCN6750/IPCC host13 route. No built-in MMIO callback is supplied. */
+    bool (*ring)(void *);
+    void (*sleep_us)(void *, uint32_t);
+    uint64_t (*now_us)(void *);
+    void (*log)(void *, const char *, ...);
+    void *ctx;
+};
+struct polaris_wifi_qrtr_server { uint32_t service, version, instance, node, port; };
+struct polaris_wifi_glink_status {
+    uint64_t epoch;
+    uint32_t first_error, detail, reads, writes, rings, cache_ops;
+    bool up, opened, peer_seen, stopping, uncertain, pending, quiescent;
+};
+#define POLARIS_WIFI_GLINK_MAX_DATAGRAM (65536u - 32u)
+struct polaris_wifi_glink;
+struct polaris_wifi_glink *polaris_wifi_glink_create(const struct polaris_wifi_glink_cfg *);
+int polaris_wifi_glink_start(struct polaris_wifi_glink *);
+int polaris_wifi_glink_poll_once(struct polaris_wifi_glink *);
+int polaris_wifi_glink_close_port(struct polaris_wifi_qrtr_port *);
+int polaris_wifi_glink_status(struct polaris_wifi_glink *, struct polaris_wifi_glink_status *);
+/* stop is nonblocking: EBUSY while ports/data/intents/CLOSE_ACK remain. Keep
+ * polling on the same lease, close clients, then call stop again. Broken or
+ * uncertain never becomes quiescent through retry. No raw reset fallback. */
+int polaris_wifi_glink_stop(struct polaris_wifi_glink *);
+/* Callers must quiesce and discard all handles first. Rejects active/broken. */
+int polaris_wifi_glink_destroy(struct polaris_wifi_glink *);
+const struct polaris_wifi_qrtr_ops *polaris_wifi_glink_qrtr_ops(struct polaris_wifi_glink *);
+int polaris_wifi_glink_qrtr_servers(struct polaris_wifi_glink *, struct polaris_wifi_qrtr_server *, unsigned);
+int polaris_wifi_glink_qrtr_publish(struct polaris_wifi_glink *, struct polaris_wifi_qrtr_port *, uint32_t, uint32_t, uint32_t);
+/* API/callback gate is a bounded try gate. Callbacks may send/lookup/close,
+ * nesting <=4; never wait for another caller. Lifecycle outside callbacks.
+ * send success means copied to ordered SMEM TX, NOT remote DONE / firmware
+ * start / radio scan / association; transport stop additionally waits DONE. */
+#endif
diff --git a/bsd/dev/polaris-wifi-cap.h b/bsd/dev/polaris-wifi-cap.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/polaris-wifi-cap.h
@@ -0,0 +1,27 @@
+/* Live service-discovered WLFW CAP client, not firmware activation or Wi-Fi. */
+#ifndef POLARIS_WIFI_CAP_H
+#define POLARIS_WIFI_CAP_H
+#include "polaris-wifi-glink.h"
+#include "polaris-wlfw.h"
+struct polaris_wifi_cap_client {
+    struct polaris_wifi_glink *transport;
+    const struct polaris_wifi_qrtr_ops *ops;
+    struct polaris_wifi_qrtr_port *port;
+    uint64_t epoch, last_us, issued_us;
+    uint32_t node, service_port, error, unrelated;
+    uint16_t transaction;
+    bool discovered, requested, awaiting, done;
+    size_t raw_bytes;
+    uint8_t raw[7 + PW_CAP_MAX_BODY];
+    struct polaris_wlfw_cap capability;
+};
+/* A single native worker owns client API calls; transport callbacks may run
+ * reentrantly on that worker. Caller owns object until callbacks have ended
+ * and close succeeds. Concurrent use must be serialized by that owner. */
+int polaris_wifi_cap_open(struct polaris_wifi_cap_client *, struct polaris_wifi_glink *, uint64_t);
+/* One request total per object; no timeout/rejected-peer retry. Peer comes only
+ * from live NEW_SERVER service0x45/version1/instance0. Does not guess node4/13. */
+int polaris_wifi_cap_request(struct polaris_wifi_cap_client *, uint16_t, uint64_t);
+int polaris_wifi_cap_poll(struct polaris_wifi_cap_client *, uint64_t);
+int polaris_wifi_cap_close(struct polaris_wifi_cap_client *);
+#endif
diff --git a/bsd/dev/polaris-wifi-smem-probe.h b/bsd/dev/polaris-wifi-smem-probe.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/polaris-wifi-smem-probe.h
@@ -0,0 +1,117 @@
+/* Bounded physical-read adapter for an ALREADY mapped own-DT SMEM span.
+ * This inventories live metadata and FIFO indices; it grants no write lease. */
+#ifndef POLARIS_WIFI_SMEM_PROBE_H
+#define POLARIS_WIFI_SMEM_PROBE_H
+#include "polaris-glink-inventory.h"
+#define PWF_SMEM_PHYSICAL UINT64_C(0x86000000)
+#define PWF_SMEM_BYTES 0x200000u
+#define PWF_SMEM_PAGES (PWF_SMEM_BYTES / 4096u)
+struct polaris_wifi_probe_io {
+    void *context;
+    uintptr_t virtual_base;
+    uint64_t epoch;
+    /* Native callback: read-only identity/lifetime check; no Get/Alloc. */
+    bool (*live)(void *, uint64_t);
+    /* Return actual translated PA and raw architectural PAR for this mapping.
+     * Caller must check current EL/regime before AT. Failure never dereferences. */
+    bool (*translate_read)(void *, uintptr_t, uint64_t *, uint64_t *);
+    /* Must be fault-contained: an MPU/bus denial returns false; do not install
+     * a mapping or probe arbitrary MMIO to make this callback succeed. */
+    bool (*read)(void *, uintptr_t, void *, size_t);
+    bool (*order)(void *);
+};
+struct polaris_wifi_probe_result {
+    uint64_t epoch;
+    uint32_t pages, reads, error, error_offset;
+    struct polaris_glink_layout layout;
+    uint8_t descriptor[32];
+    uint32_t tx_consumer, tx_producer, rx_consumer, rx_producer;
+    bool metadata_stable, descriptor_stable, queues_empty;
+    /* Translation/readability never proves MPU programming/exclusive owner. */
+    bool mpu_verified, exclusive_owner_verified, may_transmit;
+};
+struct polaris_wifi_probe_workspace {
+    struct polaris_glink_workspace inventory;
+    struct polaris_wifi_probe_result candidate;
+    uint64_t page_par[PWF_SMEM_PAGES]; /* Actual before and after must match. */
+    const struct polaris_wifi_probe_io *io;
+};
+static inline bool pwfp_error(struct polaris_wifi_probe_workspace *w, uint32_t error, uint32_t at)
+{ if (!w->candidate.error) { w->candidate.error = error; w->candidate.error_offset = at; } return false; }
+static inline bool pwfp_read(void *ctx, uint32_t at, void *dst, size_t n)
+{
+    struct polaris_wifi_probe_workspace *w = ctx;
+    const struct polaris_wifi_probe_io *io = w->io;
+    if (!n || at > PWF_SMEM_BYTES || n > PWF_SMEM_BYTES - at ||
+        !io->live(io->context, io->epoch) || !io->order(io->context)) return pwfp_error(w, 2, at);
+    w->candidate.reads++;
+    if (!io->read(io->context, io->virtual_base + at, dst, n) || !io->order(io->context))
+        return pwfp_error(w, 3, at);
+    return true;
+}
+static inline bool pwfp_pages(struct polaris_wifi_probe_workspace *w, bool before)
+{
+    const struct polaris_wifi_probe_io *io = w->io;
+    for (uint32_t i = 0; i < PWF_SMEM_PAGES; i++) {
+        uint64_t physical = 0, par = 0;
+        if (!io->live(io->context, io->epoch) ||
+            !io->translate_read(io->context, io->virtual_base + i * 4096u, &physical, &par) ||
+            (par & 1) || physical != PWF_SMEM_PHYSICAL + i * 4096u ||
+            (!before && par != w->page_par[i])) return pwfp_error(w, 4, i * 4096u);
+        if (before) { w->page_par[i] = par; w->candidate.pages++; }
+    }
+    return true;
+}
+/* Workspace is caller-owned reserved memory, never a kernel/UEFI stack object.
+ * Result is populated even on failure, preserving the first failed stage.
+ * No write/ring/SMEM protocol callback exists in this API. */
+static inline bool polaris_wifi_smem_probe(const struct polaris_wifi_probe_io *io,
+    uint32_t own_remote, struct polaris_wifi_probe_result *out, struct polaris_wifi_probe_workspace *w)
+{
+    if (!out) return false;
+    uint8_t *result_zero = (uint8_t *)out;
+    for (size_t i = 0; i < sizeof(*out); i++) result_zero[i] = 0;
+    out->error = 1;
+    if (!io || !w || !own_remote || own_remote >= PSM_HOST_COUNT || !io->epoch || !io->virtual_base ||
+        (io->virtual_base & 4095u) || UINTPTR_MAX - io->virtual_base < PWF_SMEM_BYTES ||
+        !io->live || !io->translate_read || !io->read || !io->order) return false;
+    uint8_t *zero = (uint8_t *)&w->candidate;
+    for (size_t i = 0; i < sizeof(w->candidate); i++) zero[i] = 0;
+    w->io = io; w->candidate.epoch = io->epoch;
+    struct polaris_smem_reader reader = { pwfp_read, w, PWF_SMEM_BYTES };
+    uint8_t after[32];
+    bool ok = pwfp_pages(w, true) &&
+        polaris_glink_inventory(&reader, own_remote, &w->candidate.layout, &w->inventory);
+    if (!ok) { if (!w->candidate.error) pwfp_error(w, 5, 0); goto done; }
+    w->candidate.metadata_stable = true;
+    uint32_t desc = w->candidate.layout.descriptor.offset;
+    ok = pwfp_read(w, desc, w->candidate.descriptor, 32) && pwfp_read(w, desc, after, 32) &&
+        psm_equal(w->candidate.descriptor, after, 32);
+    if (!ok) { if (!w->candidate.error) pwfp_error(w, 6, desc); goto done; }
+    w->candidate.descriptor_stable = true;
+    w->candidate.tx_consumer = psm_u32(after);
+    w->candidate.tx_producer = psm_u32(after + 4);
+    w->candidate.rx_consumer = psm_u32(after + 8);
+    w->candidate.rx_producer = psm_u32(after + 12);
+    if (((w->candidate.tx_consumer | w->candidate.tx_producer |
+          w->candidate.rx_consumer | w->candidate.rx_producer) & 7) ||
+        w->candidate.tx_consumer >= w->candidate.layout.tx.bytes ||
+        w->candidate.tx_producer >= w->candidate.layout.tx.bytes ||
+        w->candidate.rx_consumer >= w->candidate.layout.rx.bytes ||
+        w->candidate.rx_producer >= w->candidate.layout.rx.bytes) {
+        ok = pwfp_error(w, 7, desc); goto done;
+    }
+    w->candidate.queues_empty = w->candidate.tx_consumer == w->candidate.tx_producer &&
+        w->candidate.rx_consumer == w->candidate.rx_producer;
+    struct polaris_glink_layout after_layout;
+    ok = polaris_glink_inventory(&reader, own_remote, &after_layout, &w->inventory) &&
+        psm_equal((const uint8_t *)&w->candidate.layout, (const uint8_t *)&after_layout, sizeof(after_layout)) &&
+        pwfp_pages(w, false) && io->live(io->context, io->epoch);
+    if (!ok && !w->candidate.error) pwfp_error(w, 8, 0);
+done:
+    *out = w->candidate;
+    return ok;
+}
+int polaris_wifi_smem_readonly_probe(const struct polaris_wifi_probe_io *, uint32_t,
+    struct polaris_wifi_probe_result *, struct polaris_wifi_probe_workspace *);
+#endif
diff --git a/bsd/dev/polaris-glink-inventory.h b/bsd/dev/polaris-glink-inventory.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/polaris-glink-inventory.h
@@ -0,0 +1,122 @@
+/* Read-only GLINK SMEM item inventory for Polaris. Independent implementation
+ * checked against own MiCode c7cb50c1 msm_smem.c allocation/get-entry rules and
+ * glink_smem_native_xprt.c items 478/479/480. The dipper-xnu transport was a
+ * useful comparison, not authority for this phone's addresses or permissions.
+ * Only fixed-size candidate allocation-header reads; no FIFO payload consumer,
+ * allocator, FIFO index write, doorbell, lock, DSP or MMIO. Corrupt metadata can
+ * mislabel bytes inside the bounded partition; this is not memory ownership.
+ * Caller must bind a safely readable own-DT SMEM mapping first. Optimistic
+ * metadata consistency is NOT a remote lock or permission to start transport.
+ */
+#ifndef POLARIS_GLINK_INVENTORY_H
+#define POLARIS_GLINK_INVENTORY_H
+#include "polaris-smem-inventory.h"
+#define PGL_MAX_ITEMS 512u
+#define PGL_MAX_HEADERS (2u * PGL_MAX_ITEMS)
+struct polaris_glink_item { uint32_t offset,bytes,cached; };
+struct polaris_glink_layout {
+    uint32_t remote,partition,partition_bytes,headers;
+    struct polaris_glink_item descriptor,tx,rx;
+};
+struct polaris_glink_witness { uint32_t offset;uint8_t bytes[16]; };
+/* Caller-owned, not a native kernel stack allocation. */
+struct polaris_glink_workspace {
+    struct polaris_smem_workspace smem;
+    struct polaris_smem_inventory inventory;
+    struct polaris_glink_witness headers[PGL_MAX_HEADERS];
+    uint8_t seen[2][PGL_MAX_ITEMS / 8];
+    struct polaris_glink_item items[2][3];
+    uint32_t count;
+};
+static inline bool pgl_headers(const struct polaris_smem_reader *r,
+    const struct polaris_smem_part *p,struct polaris_glink_workspace *w,bool cached)
+{
+    uint32_t at=cached?p->bytes:32,end=cached?p->cached_begin:p->uncached_end;
+    while(at!=end) {
+        uint32_t header_bytes=cached?p->cacheline:16;
+        if(w->count==PGL_MAX_HEADERS||
+           (cached?(at<end||at-end<header_bytes):(at>end||end-at<16)))return false;
+        uint32_t h=cached?at-header_bytes:at;
+        struct polaris_glink_witness *record=&w->headers[w->count];
+        record->offset=p->offset+h;
+        if(!psm_read(r,record->offset,record->bytes,16))return false;
+        const uint8_t *v=record->bytes;
+        uint32_t id=psm_u16(v+2),size=psm_u32(v+4);
+        uint32_t pad=psm_u16(v+8),header_pad=psm_u16(v+10);
+        if(psm_u16(v)!=0xa5a5||id>=PGL_MAX_ITEMS||!size||
+           (size&((cached?p->cacheline:8)-1))||pad>=size||
+           pad>=(cached?p->cacheline:8)||header_pad!=header_bytes-16||
+           (w->seen[cached][id/8]&(1u<<(id%8))))return false;
+        uint32_t data,next;
+        if(cached) {
+            if(size>h||h-size<end)return false;
+            data=h-size;next=data;
+        } else {
+            if(header_bytes>end-at||size>end-at-header_bytes)return false;
+            data=at+header_bytes;next=data+size;
+        }
+        w->seen[cached][id/8]|=(uint8_t)(1u<<(id%8));w->count++;
+        if(id>=478&&id<=480) {
+            uint32_t n=(size-pad+7u)&~7u;
+            if(!n||n>size)return false;
+            w->items[cached][id-478]=(struct polaris_glink_item){p->offset+data,n,cached};
+        }
+        at=next;
+    }
+    return true;
+}
+static inline bool polaris_glink_inventory(const struct polaris_smem_reader *r,
+    uint32_t remote,struct polaris_glink_layout *out,struct polaris_glink_workspace *w)
+{
+    if(!out||!w||!remote||remote>=PSM_HOST_COUNT||
+       !polaris_smem_inventory(r,&w->inventory,&w->smem))return false;
+    const struct polaris_smem_part *p=0;
+    for(uint32_t i=0;i<w->inventory.count;i++) {
+        const struct polaris_smem_part *q=&w->inventory.parts[i];
+        if(q->accessible&&((!q->host0&&q->host1==remote)||(!q->host1&&q->host0==remote))) {
+            if(p)return false;
+            p=q;
+        }
+    }
+    if(!p||p->flags||p->exclusions[0]||p->exclusions[1]||
+       p->exclusions[2]||p->exclusions[3])return false; /* No unsupported layout. */
+    for(unsigned k=0;k<2;k++) {
+        for(unsigned n=0;n<sizeof(w->seen[k]);n++)w->seen[k][n]=0;
+        for(unsigned n=0;n<3;n++)w->items[k][n]=(struct polaris_glink_item){0};
+    }
+    w->count=0;
+    if(!pgl_headers(r,p,w,false)||!pgl_headers(r,p,w,true))return false;
+    /* Own probe allocates descriptor and TX uncached. Only get_rx_fifo tries
+     * cached first and then uncached; do not substitute a cached TX allocation
+     * merely because the reference port's generic lookup can find one. */
+    struct polaris_glink_layout candidate={remote,p->offset,p->bytes,w->count,
+        w->items[0][0],w->items[0][1],
+        w->items[w->items[1][2].bytes?1:0][2]};
+    if(candidate.descriptor.bytes!=32||w->items[1][0].bytes)return false;
+    const struct polaris_glink_item *items[3]={&candidate.descriptor,&candidate.tx,&candidate.rx};
+    for(unsigned i=0;i<3;i++) {
+        const struct polaris_glink_item *v=items[i];
+        if(!v->bytes||(v->offset&7)||v->offset<p->offset+32||v->offset>p->offset+p->bytes||
+           v->bytes>p->offset+p->bytes-v->offset||
+           (i&&(v->bytes<64||v->bytes>0x200000||(v->bytes&7))))return false;
+        for(unsigned j=0;j<i;j++)if(v->offset<items[j]->offset+items[j]->bytes&&
+            items[j]->offset<v->offset+v->bytes)return false;
+    }
+    /* Exact re-read of every inspected allocation header, the chosen partition
+     * header, legacy header and whole TOC. Never read item contents or publish
+     * partial results when the remote changes allocation metadata. */
+    uint8_t bytes[PSM_LEGACY_HEADER_BYTES];
+    for(uint32_t n=0;n<w->count;n++)if(!psm_read(r,w->headers[n].offset,bytes,16)||
+        !psm_equal(bytes,w->headers[n].bytes,16))return false;
+    if(!psm_read(r,p->offset,bytes,32)||!psm_equal(bytes,w->smem.part_headers[p->index],32)||
+       !psm_read(r,0,bytes,PSM_LEGACY_HEADER_BYTES)||
+       !psm_equal(bytes,w->smem.legacy,PSM_LEGACY_HEADER_BYTES))return false;
+    for(uint32_t at=0;at<PSM_TABLE_BYTES;) {
+        uint32_t n=PSM_TABLE_BYTES-at;if(n>sizeof(bytes))n=sizeof(bytes);
+        if(!psm_read(r,r->bytes-PSM_TABLE_BYTES+at,bytes,n)||
+           !psm_equal(bytes,w->smem.table+at,n))return false;
+        at+=n;
+    }
+    *out=candidate;return true;
+}
+#endif
diff --git a/bsd/dev/polaris-smem-inventory.h b/bsd/dev/polaris-smem-inventory.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/polaris-smem-inventory.h
@@ -0,0 +1,118 @@
+/* Read-only private/common SMEM metadata inventory, never an allocator.
+ * Wire fields checked against MiCode c7cb50c1 msm_smem.c (1bbd7514...) and
+ * smem_private.h. Independent implementation; no MMIO, pointers, writes,
+ * lock acquisition, retry, DSP start or permission to use item contents.
+ * Caller must first bind the original DT region and a safe read-only mapping.
+ * Stable metadata is not evidence that a remote processor is running.
+ */
+#ifndef POLARIS_SMEM_INVENTORY_H
+#define POLARIS_SMEM_INVENTORY_H
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+#define PSM_TABLE_BYTES 4096u
+#define PSM_LEGACY_HEADER_BYTES 208u
+#define PSM_LEGACY_BYTES (PSM_LEGACY_HEADER_BYTES + 512u * 16u)
+#define PSM_HOST_COUNT 10u
+#define PSM_MAX_PARTS ((PSM_TABLE_BYTES-32u)/48u)
+struct polaris_smem_part {
+    uint32_t index,offset,bytes,flags,cacheline,uncached_end,cached_begin;
+    uint32_t exclusions[4];
+    uint16_t host0,host1;
+    /* APPS/common header was checked, not access or write authorization. */
+    uint8_t accessible,reserved[3];
+};
+struct polaris_smem_inventory {
+    uint32_t version,count,accessible_count,common_index;
+    struct polaris_smem_part parts[PSM_MAX_PARTS];
+};
+/* Caller-owned workspace: do not put this on a native kernel stack. */
+struct polaris_smem_workspace {
+    uint8_t legacy[PSM_LEGACY_HEADER_BYTES],table[PSM_TABLE_BYTES],scratch[PSM_LEGACY_HEADER_BYTES];
+    uint8_t part_headers[PSM_MAX_PARTS][32];
+    struct polaris_smem_inventory candidate;
+};
+struct polaris_smem_reader {
+    bool (*read)(void *,uint32_t,void *,size_t);
+    void *context;
+    uint32_t bytes;
+};
+static inline uint16_t psm_u16(const uint8_t *p)
+{return (uint16_t)p[0]|((uint16_t)p[1]<<8);}
+static inline uint32_t psm_u32(const uint8_t *p)
+{return (uint32_t)p[0]|((uint32_t)p[1]<<8)|((uint32_t)p[2]<<16)|((uint32_t)p[3]<<24);}
+static inline bool psm_equal(const uint8_t *a,const uint8_t *b,size_t n)
+{for(size_t i=0;i<n;i++)if(a[i]!=b[i])return false;return true;}
+static inline bool psm_read(const struct polaris_smem_reader *r,uint32_t offset,void *out,size_t n)
+{
+    return r&&r->read&&out&&n&&offset<=r->bytes&&n<=r->bytes-offset&&
+        r->read(r->context,offset,out,n);
+}
+static inline bool polaris_smem_inventory(const struct polaris_smem_reader *r,
+    struct polaris_smem_inventory *out,struct polaris_smem_workspace *work)
+{
+    if(!out||!r||!work||out==&work->candidate||r->bytes<16384||r->bytes>UINT32_C(0x10000000))return false;
+    uint8_t *legacy=work->legacy,*table=work->table;
+    if(!psm_read(r,0,legacy,PSM_LEGACY_HEADER_BYTES))return false;
+    uint32_t version=psm_u32(legacy+64+7*4);
+    if((version!=0xb0000&&version!=0xc0000)||psm_u32(legacy+192)!=1||psm_u32(legacy+204))return false;
+    uint32_t toc=r->bytes-PSM_TABLE_BYTES;
+    if(!psm_read(r,toc,table,PSM_TABLE_BYTES)||psm_u32(table)!=UINT32_C(0x434f5424)||psm_u32(table+4)!=1)return false;
+    uint32_t count=psm_u32(table+8);
+    if(!count||count>PSM_MAX_PARTS)return false;
+    struct polaris_smem_inventory *inventory=&work->candidate;
+    uint8_t *zero=(uint8_t *)inventory;
+    for(size_t n=0;n<sizeof(*inventory);n++)zero[n]=0;
+    inventory->version=version;inventory->count=count;inventory->common_index=UINT32_MAX;
+    for(uint32_t i=0;i<count;i++) {
+        const uint8_t *e=table+32+i*48;struct polaris_smem_part *p=&inventory->parts[i];
+        p->index=i;p->offset=psm_u32(e);p->bytes=psm_u32(e+4);p->flags=psm_u32(e+8);
+        p->host0=psm_u16(e+12);p->host1=psm_u16(e+14);p->cacheline=psm_u32(e+16);
+        for(unsigned n=0;n<4;n++)p->exclusions[n]=psm_u32(e+32+n*4);
+        if(!p->offset&&!p->bytes)continue; /* Empty TOC slot is not a partition. */
+        if(p->offset<PSM_LEGACY_BYTES||!p->bytes||p->bytes<32||p->offset>toc||p->bytes>toc-p->offset)return false;
+        for(uint32_t j=0;j<i;j++) {
+            const struct polaris_smem_part *q=&inventory->parts[j];
+            if(q->bytes&&p->offset<q->offset+q->bytes&&q->offset<p->offset+p->bytes)return false;
+        }
+        bool common=p->host0==0xfffe&&p->host1==0xfffe;
+        if(!common&&p->host0&&p->host1)continue; /* Never inspect another host's header. */
+        if(!p->cacheline||(p->cacheline&(p->cacheline-1))||p->cacheline<16||p->cacheline>4096)return false;
+        if(common) {
+            if(inventory->common_index!=UINT32_MAX)return false;
+            inventory->common_index=i;
+        } else {
+            uint16_t remote=p->host0?p->host0:p->host1;
+            if(!remote||remote>=PSM_HOST_COUNT)return false;
+            for(uint32_t j=0;j<i;j++) {
+                const struct polaris_smem_part *q=&inventory->parts[j];
+                if(q->accessible&&((q->host0==p->host0&&q->host1==p->host1)||
+                    (q->host0==p->host1&&q->host1==p->host0)))return false;
+            }
+        }
+        uint8_t *header=work->part_headers[i];
+        uint8_t header_after[32];
+        if(!psm_read(r,p->offset,header,32)||psm_u32(header)!=UINT32_C(0x54525024)||
+           psm_u16(header+4)!=p->host0||psm_u16(header+6)!=p->host1||psm_u32(header+8)!=p->bytes)return false;
+        p->uncached_end=psm_u32(header+12);p->cached_begin=psm_u32(header+16);
+        if(p->uncached_end<32||p->uncached_end>p->cached_begin||p->cached_begin>p->bytes)return false;
+        if(!psm_read(r,p->offset,header_after,sizeof(header_after))||!psm_equal(header,header_after,32))return false;
+        p->accessible=1;inventory->accessible_count++;
+    }
+    if(version==0xc0000&&inventory->common_index==UINT32_MAX)return false;
+    /* Optimistic consistency only: this is not an atomic snapshot or a remote
+     * lock. Reject changes observed across the entire inventory; callers may
+     * not use these offsets to read item data or modify shared memory. */
+    for(uint32_t at=0;at<PSM_TABLE_BYTES;) {
+        uint32_t n=PSM_TABLE_BYTES-at;if(n>sizeof(work->scratch))n=sizeof(work->scratch);
+        if(!psm_read(r,toc+at,work->scratch,n)||!psm_equal(table+at,work->scratch,n))return false;
+        at+=n;
+    }
+    if(!psm_read(r,0,work->scratch,PSM_LEGACY_HEADER_BYTES)||!psm_equal(legacy,work->scratch,PSM_LEGACY_HEADER_BYTES))return false;
+    for(uint32_t i=0;i<count;i++)if(inventory->parts[i].accessible) {
+        if(!psm_read(r,inventory->parts[i].offset,work->scratch,32)||
+           !psm_equal(work->part_headers[i],work->scratch,32))return false;
+    }
+    *out=*inventory;return true;
+}
+#endif
diff --git a/bsd/dev/polaris-wlfw.h b/bsd/dev/polaris-wlfw.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/polaris-wlfw.h
@@ -0,0 +1,90 @@
+/* Original Polaris ICNSS WLFW capability wire format, not a radio driver.
+ * Verified MiCode c7cb50c1 wlan_firmware_service_v01.{h,c}:
+ * header96c03d62 / descriptor96e7d689 / qmi_encdec d7221d89.
+ * Independent bounded codec; no Linux implementation or hardware addresses.
+ * Transport must authenticate the discovered service/node/port separately.
+ * Parsing a response is never firmware boot, scan, association or DMA proof.
+ */
+#ifndef POLARIS_WLFW_H
+#define POLARIS_WLFW_H
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+#define PW_SERVICE 0x45u
+#define PW_VERSION 1u
+#define PW_INSTANCE 0u
+#define PW_CAP_MESSAGE 0x24u
+#define PW_CAP_MAX_BODY 203u
+struct polaris_wlfw_cap {
+    uint32_t valid,chip_id,chip_family,board_id,soc_id,firmware_version;
+    uint16_t result,error;
+    char timestamp[33],build_id[129];
+};
+static inline uint16_t pw_le16(const uint8_t *p)
+{return (uint16_t)p[0]|(uint16_t)((uint16_t)p[1]<<8);}
+static inline uint32_t pw_le32(const uint8_t *p)
+{return (uint32_t)p[0]|((uint32_t)p[1]<<8)|((uint32_t)p[2]<<16)|((uint32_t)p[3]<<24);}
+static inline bool polaris_wlfw_cap_request(uint16_t transaction,uint8_t *out,size_t n)
+{
+    if(!transaction||!out||n<7)return false;
+    out[0]=0;out[1]=(uint8_t)transaction;out[2]=(uint8_t)(transaction>>8);
+    out[3]=PW_CAP_MESSAGE;out[4]=out[5]=out[6]=0;return true;
+}
+static inline bool pw_text(char *out,size_t capacity,const uint8_t *p,size_t n)
+{
+    if(n>=capacity)return false;
+    for(size_t i=0;i<n;i++) {
+        /* Firmware identifiers are diagnostics, never commands or paths. */
+        if(p[i]<0x20||p[i]>0x7e)return false;
+        out[i]=(char)p[i];
+    }
+    out[n]=0;return true;
+}
+static inline bool polaris_wlfw_cap_response(uint32_t service,uint32_t version,
+    uint32_t instance,uint16_t transaction,const uint8_t *p,size_t n,
+    struct polaris_wlfw_cap *out)
+{
+    if(!out||!p||!transaction||service!=PW_SERVICE||version!=PW_VERSION||instance!=PW_INSTANCE||
+       n<7||n>7+PW_CAP_MAX_BODY||p[0]!=2||pw_le16(p+1)!=transaction||
+       pw_le16(p+3)!=PW_CAP_MESSAGE||pw_le16(p+5)!=n-7)return false;
+    struct polaris_wlfw_cap c={0};uint8_t seen[32]={0};bool result_seen=false;
+    for(size_t at=7;at<n;) {
+        if(n-at<3)return false;
+        unsigned type=p[at];size_t len=pw_le16(p+at+1);at+=3;
+        if(len>n-at||(seen[type/8]&(1u<<(type%8))))return false;
+        seen[type/8]|=(uint8_t)(1u<<(type%8));const uint8_t *v=p+at;
+        switch(type) {
+        case 2:
+            if(len!=4)return false;
+            c.result=pw_le16(v);c.error=pw_le16(v+2);result_seen=true;
+            if(c.result>1||(!c.result&&c.error))return false;
+            break;
+        case 0x10:
+            if(len!=8)return false;
+            c.chip_id=pw_le32(v);c.chip_family=pw_le32(v+4);c.valid|=1;break;
+        case 0x11:
+            if(len!=4)return false;
+            c.board_id=pw_le32(v);c.valid|=2;break;
+        case 0x12:
+            if(len!=4)return false;
+            c.soc_id=pw_le32(v);c.valid|=4;break;
+        case 0x13:
+            /* Nested QMI_STRING has a one-byte length. Top-level build-id
+             * below instead obtains its length directly from the TLV. */
+            if(len<5||len!=(size_t)5+v[4]||!pw_text(c.timestamp,sizeof(c.timestamp),v+5,v[4]))return false;
+            c.firmware_version=pw_le32(v);c.valid|=8;break;
+        case 0x14:
+            if(!pw_text(c.build_id,sizeof(c.build_id),v,len))return false;
+            c.valid|=16;break;
+        default:
+            if(type<0x10)return false; /* Unknown mandatory field. */
+            break; /* Unknown bounded optional TLV is forward compatible. */
+        }
+        at+=len;
+    }
+    if(!result_seen)return false;
+    *out=c;return true; /* Caller must separately check result and valid bits. */
+}
+static inline bool polaris_wlfw_cap_has_identity(const struct polaris_wlfw_cap *c)
+{return c&&!c->result&&!c->error&&(c->valid&9)==9;}
+#endif
