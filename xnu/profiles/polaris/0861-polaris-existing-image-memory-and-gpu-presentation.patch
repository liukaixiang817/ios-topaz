 /* 20H392 IOSurfaceClientWrapClientImage/Memory: selectors6/7 must return
  * exactly the same mapped lock result as create, NEVER a zero success.
  * Pin the caller's original storage; no copied/stale texture and no header
  * page added to an allocation we do not own. IOMemoryDescriptor retains its
  * task/map and prepare wires its pages until the last surface/port releases.
  * GPU's existing importer deliberately refuses these external descriptors;
  * EAGL uses its existing texture upload path for them. */
 IOReturn
 IOSurfaceRootUserClient::wrap(uint32_t selector, IOExternalMethodArguments *args)
 {
     struct pgpu_surface_image image = {};
     if (selector == kSweetSurfaceWrapImage) {
         if (args->scalarInputCount || args->structureInputDescriptor ||
             !args->structureInput || args->structureInputSize != sizeof(image)) return kIOReturnBadArgument;
         memcpy(&image,args->structureInput,sizeof(image));
         if (!pgpu_surface_image_valid(&image)) return kIOReturnBadArgument;
     } else {
         if (args->scalarInputCount != 2 || args->structureInputSize || args->structureInputDescriptor ||
             !pgpu_surface_range(args->scalarInput[0],args->scalarInput[1])) return kIOReturnBadArgument;
         image.address=args->scalarInput[0];image.bytes=(uint32_t)args->scalarInput[1];image.element=1;
         image.width=image.row=image.bytes;image.height=1;
     }
     SweetSurface *s=sweet_surface_alloc();
     if (!s) return kIOReturnNoMemory;
     s->width=image.width;s->height=image.height;s->pixelFormat=image.format;
     s->bytesPerElement=(uint16_t)image.element;s->elementWidth=s->elementHeight=1;
     s->bytesPerRow=image.row;s->allocSize=image.bytes;s->mapCache=kIOMapDefaultCache;
     IOReturn ret=kIOReturnNoMemory;
     uint64_t before=(uint64_t)OSAddAtomic64(s->allocSize,(volatile SInt64 *)&sweet_surface_wired);
     s->wiredAccounted=true;
     if (before+s->allocSize <= SWEET_SURFACE_WIRED_MAX) {
         for (unsigned attempt=0;attempt<2;attempt++) {
             s->memory=IOMemoryDescriptor::withAddressRange(image.address,image.bytes,
                 attempt ? kIODirectionOut : kIODirectionInOut,fTask);
             if (s->memory && s->memory->prepare()==kIOReturnSuccess) {
                 s->externalPrepared=true;
                 if (attempt) s->mapCache |= kIOMapReadOnly;
                 ret=kIOReturnSuccess;break;
             }
             OSSafeReleaseNULL(s->memory);
         }
         if (!s->externalPrepared)ret=kIOReturnVMError;
     }
     if (ret==kIOReturnSuccess && !sweet_surface_publish(s))ret=kIOReturnNoResources;
     if (ret==kIOReturnSuccess)ret=returnSurface(s,args); /* takes table user count, undoes on output failure */
     sweet_surf_log_once("wrap",selector);
     s->release();return ret;
 }
 
