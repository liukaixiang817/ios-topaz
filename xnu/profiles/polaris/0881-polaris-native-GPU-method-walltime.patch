+/* Serialized by gpuLock. Sums are admitted native method WALL time, including
+ * preemption; overlapping lock waits are not CPU busy time. Mach/IOKit work
+ * before entering these callbacks and the diagnostic print/unlock are excluded.
+ * No cached identity, permission check, DMA or fence behavior is changed. */
+struct PolarisMethodBin {uint64_t calls,errors,auth,dispatch,lock,body,total,maximum;};
+struct PolarisMethodMeter {uint64_t began,lastEnded,calls;PolarisMethodBin bins[9];};
+static PolarisMethodMeter gpuMethodMeter;
+static unsigned polaris_gpu_method_bin(uint32_t selector)
+{
+    switch(selector) {
+        case 0x42:return 0;case 0x43:return 1;case 0x44:case 0x45:return 2;
+        case 0x46:return 3;case 0x47:return 4;case 0x7e:return 5;
+        case 0x09:return 6;case 0x10000:return 7;default:return 8;
+    }
+}
+static bool polaris_gpu_method_record(PolarisMethodMeter *m,uint32_t selector,uint32_t error,
+    uint64_t entered,uint64_t authed,uint64_t waiting,uint64_t locked,uint64_t ended)
+{
+    if(!m || !(entered<=authed && authed<=waiting && waiting<=locked && locked<=ended) ||
+        (m->calls && ended<m->lastEnded))return false;
+    if(!m->calls || entered<m->began)m->began=entered; /* overlapping callers */
+    m->lastEnded=ended;
+    PolarisMethodBin *b=&m->bins[polaris_gpu_method_bin(selector)];
+    b->calls++;b->errors+=error!=0;m->calls++;
+    b->auth+=polaris_gpu_elapsed_us(entered,authed);
+    b->dispatch+=polaris_gpu_elapsed_us(authed,waiting);
+    b->lock+=polaris_gpu_elapsed_us(waiting,locked);
+    b->body+=polaris_gpu_elapsed_us(locked,ended);
+    uint64_t total=polaris_gpu_elapsed_us(entered,ended);
+    b->total+=total;if(total>b->maximum)b->maximum=total;
+    return selector==0x46 && polaris_gpu_elapsed_us(m->began,ended)>=2000000;
+}
+static void polaris_gpu_method_flush(PolarisMethodMeter *m,uint64_t ended)
+{
+    static const char *const names[]={"make","info","prep","submit","fence","surface","close","map","other"};
+    uint64_t ns;absolutetime_to_nanoseconds(ended,&ns);
+    for(unsigned n=0;n<9;n++) {
+        const PolarisMethodBin *b=&m->bins[n];if(!b->calls)continue;
+        IOLog("POLARIS GPU METHOD PERF: end_us=%llu window_us=%llu kind=%s calls=%llu errors=%llu auth_us=%llu dispatch_us=%llu lock_us=%llu body_us=%llu total_us=%llu max_us=%llu\n",
+            ns/1000,polaris_gpu_elapsed_us(m->began,ended),names[n],b->calls,b->errors,
+            b->auth,b->dispatch,b->lock,b->body,b->total,b->maximum);
+    }
+    *m=(PolarisMethodMeter){};
