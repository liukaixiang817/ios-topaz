+static bool polaris_pair_vm_read(void *v,uint32_t offset,uint32_t *out)
+{
+    struct polaris_pair_vm *s=(struct polaris_pair_vm *)v;
+    if(offset<0xbc || offset>0xd0 || (offset&3))return false;
+    unsigned n=(offset-0xbc)/4;if(s->cursor[n]>=4 || s->reads>=72)return false;
+    s->reads++;if(s->fail==s->reads)return false;
+    *out=(1u<<21)|((uint32_t)s->value[n][s->cursor[n]]&0xfff);
+    if(s->critical==s->reads){*out=1u<<19;return true;}
+    if(s->attempt[n]++<s->invalid){*out&=~(1u<<21);return true;}
+    s->attempt[n]=0;s->cursor[n]++;return true;
+}
+static uint64_t polaris_pair_vm_now(void *v)
+{return 100+10*((struct polaris_pair_vm *)v)->clocks++;}
+static struct polaris_pair_vm polaris_pair_vm_fixture(void)
